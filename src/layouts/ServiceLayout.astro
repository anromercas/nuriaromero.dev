---
import Layout from "@/layouts/Layout.astro"
import Schema from "@/components/seo/Schema.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import TitleSection from "@/components/TitleSection.astro"
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import PageUpdated from "@/components/PageUpdated.astro"
import { getPageDateModified } from "@/data/page-freshness"
import ServiceHero from "@/components/services/ServiceHero.astro"
import BenefitsGrid from "@/components/services/BenefitsGrid.astro"
import ProcessSteps from "@/components/services/ProcessSteps.astro"
import PricingCard from "@/components/services/PricingCard.astro"
import FAQ from "@/components/services/FAQ.astro"
import CTASection from "@/components/services/CTASection.astro"
import InternalLinks from "@/components/InternalLinks.astro"
import { internalLinksBySource } from "@/data/internal-links"
import CodeIcon from "@/components/icons/Code.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import { serviceSchema, faqSchema, breadcrumbSchema } from "@/lib/schema"
import type { ServicePageData } from "@/data/types"

interface Props {
  page: ServicePageData
  variant?: "legacy" | "template"
}

const { page, variant = "legacy" } = Astro.props
const dateModified = getPageDateModified(Astro.url.pathname)

const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: page.breadcrumbName, url: page.slug },
]
---

<Layout title={page.seo.title} description={page.seo.description}>
  <Schema
    slot="head"
    schema={[
      serviceSchema({
        name: page.hero.h1,
        description: page.seo.description,
        url: page.slug,
        serviceType: page.breadcrumbName,
        price: page.ownOffer === false ? undefined : page.pricing.from,
        ...(page.offersFromTiers && page.pricing.tiers
          ? { tiers: page.pricing.tiers, billing: page.tierBilling, id: "service" }
          : {}),
      }),
      faqSchema(page.faqs),
      breadcrumbSchema(breadcrumbs),
    ]}
  />
  <main class={variant === "template" ? "template-ground px-4 pt-24" : "px-4 pt-24"}>
    {variant === "template" ? (
      <Fragment>
        <SectionContainer>
          <div class="page-meta">
            <Breadcrumbs items={breadcrumbs} />
            <PageUpdated date={dateModified} />
          </div>
          <slot name="hero" />
        </SectionContainer>

        <div class="space-y-24 mt-8">
          <slot name="before-benefits" />
          <slot name="benefits" />
          <slot name="process" />
          <slot name="before-pricing" />
          <slot name="pricing" />
          <slot />
          <slot name="faq" />
          <slot name="related" />
          <slot name="closing" />
        </div>
      </Fragment>
    ) : (
      <Fragment>
        <SectionContainer>
          <div class="page-meta">
            <Breadcrumbs items={breadcrumbs} />
            <PageUpdated date={dateModified} />
          </div>
          <slot name="hero"><ServiceHero
              h1={page.hero.h1}
              subtitle={page.hero.subtitle}
              primaryCtaLabel={page.hero.primaryCtaLabel}
              secondaryCta={page.hero.secondaryCta}
            /></slot>
        </SectionContainer>

        <div class="space-y-24 mt-8">
          <slot name="before-benefits" />

          <slot name="benefits"><SectionContainer>
              <TitleSection>
                <ProfileCheck class="size-8" />
                {page.sectionTitles?.benefits ?? "Qué vas a conseguir"}
              </TitleSection>
              <BenefitsGrid benefits={page.benefits} />
            </SectionContainer></slot>

          <slot name="process"><SectionContainer>
              <TitleSection>
                <Briefcase class="size-8" />
                {page.sectionTitles?.process ?? "Cómo trabajo"}
              </TitleSection>
              <ProcessSteps steps={page.process} />
            </SectionContainer></slot>

          <slot name="before-pricing" /><slot name="pricing"><SectionContainer id="precios">
            <TitleSection>
              <CodeIcon class="size-7" />
              {page.sectionTitles?.pricing ?? "Precio orientativo"}
            </TitleSection>
            <PricingCard
              from={page.pricing.from}
              includes={page.pricing.includes}
              note={page.pricing.note}
              initial={page.pricing.initial}
              tiers={page.pricing.tiers}
            />
          </SectionContainer></slot>

          <slot />

          <slot name="faq"><SectionContainer>
            <TitleSection>
              <ProfileCheck class="size-8" />
              {page.sectionTitles?.faq ?? "Preguntas frecuentes"}
            </TitleSection>
            <FAQ faqs={page.faqs} />
          </SectionContainer></slot>

          <slot name="related"><SectionContainer>
            <InternalLinks links={internalLinksBySource[page.slug] ?? []} />
          </SectionContainer></slot>

          <slot name="closing"><SectionContainer>
            <CTASection title={page.cta?.title} text={page.cta?.text} buttonLabel={page.cta?.buttonLabel} />
          </SectionContainer></slot>
        </div>
      </Fragment>
    )}
  </main>
</Layout>

<style>
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .page-meta :global(.crumbs) {
    margin-bottom: 0;
  }
</style>
