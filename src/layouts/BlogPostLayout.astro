---
import Layout from "@/layouts/Layout.astro"
import Schema from "@/components/seo/Schema.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Breadcrumbs from "@/components/Breadcrumbs.astro"
import CTASection from "@/components/services/CTASection.astro"
import EntryContentStyles from "@/components/EntryContentStyles.astro"
import { articleSchema, breadcrumbSchema } from "@/lib/schema"
import type { CollectionEntry } from "astro:content"

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { title, description, pubDate, updatedDate, image } = post.data
const url = `/blog/${post.slug}`

const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Blog", url: "/blog" },
  { name: title, url },
]

const formattedDate = pubDate.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
})
---

<Layout title={title} description={description} ogType="article" ogImage={image}>
  <Schema
    slot="head"
    schema={[
      articleSchema({ title, description, url, pubDate, updatedDate, image }),
      breadcrumbSchema(breadcrumbs),
    ]}
  />
  <main class="px-4 pt-24">
    <SectionContainer>
      <Breadcrumbs items={breadcrumbs} />
      <article>
        <header class="mb-10">
          <h1
            class="text-3xl font-bold tracking-tight text-gray-800 sm:text-4xl dark:text-white mb-4"
          >
            {title}
          </h1>
          <p class="text-lg text-gray-700 dark:text-gray-400">{description}</p>
          <time
            datetime={pubDate.toISOString()}
            class="mt-3 block text-sm text-gray-600 dark:text-gray-500"
          >
            {formattedDate}
          </time>
        </header>
        <EntryContentStyles />
        <div class="entry-content">
          <slot />
        </div>
      </article>
    </SectionContainer>

    <SectionContainer class="mt-24">
      <CTASection />
    </SectionContainer>
  </main>
</Layout>
