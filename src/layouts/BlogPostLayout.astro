---
import Layout from "@/layouts/Layout.astro";
import Schema from "@/components/seo/Schema.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SeoLocalRelated from "@/components/seo-local/SeoLocalRelated.astro";
import SeoLocalClosing from "@/components/seo-local/SeoLocalClosing.astro";
import { internalLinksBySource } from "@/data/internal-links";
import { articleSchema, breadcrumbSchema } from "@/lib/schema";
import "@/styles/template.css";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, image } = post.data;
const url = `/blog/${post.slug}/`;

const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Blog", url: "/blog/" },
  { name: title, url },
];

const formatDate = (date: Date) =>
  date.toLocaleDateString("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : undefined;
const relatedLinks = internalLinksBySource[url] ?? [];
---

<Layout
  title={title}
  description={description}
  ogType="article"
  ogImage={image}
>
  <Schema
    slot="head"
    schema={[
      articleSchema({ title, description, url, pubDate, updatedDate, image }),
      breadcrumbSchema(breadcrumbs),
    ]}
  />
  <main class="template-ground px-4 pt-24">
    <div class="space-y-24">
      <SectionContainer>
        <Breadcrumbs items={breadcrumbs} />
        <article>
          <header class="post-header">
            <h1 class="tpl-display post-title">{title}</h1>
            <p class="post-lede">{description}</p>
            <p class="post-meta">
              Por{" "}
              <a href="/sobre-mi/" class="tpl-link">
                Nuria Romero Castillo
              </a>
              {" · "}
              <span>
                Publicado el{" "}
                <time datetime={pubDate.toISOString()} data-post-published>{formattedPubDate}</time>
              </span>
              {updatedDate && formattedUpdatedDate && (
                <span>
                  {" · "}Actualizado el{" "}
                  <time datetime={updatedDate.toISOString()} data-post-updated>
                    {formattedUpdatedDate}
                  </time>
                </span>
              )}
            </p>
          </header>
          <div class="post-prose" data-post-body>
            <slot />
          </div>
        </article>
      </SectionContainer>

      {relatedLinks.length > 0 && (
        <SectionContainer>
          <SeoLocalRelated links={relatedLinks} />
        </SectionContainer>
      )}

      <SectionContainer>
        <SeoLocalClosing
          headingId="post-cierre-title"
          keyword="Reserva una llamada"
          title={{
            text: "¿Quieres aplicarlo a tu negocio?",
            accent: "a tu negocio",
          }}
          text="Cuéntame tu caso y vemos juntos qué tiene sentido para tu web, tu ficha de Google o tus búsquedas con IA."
        />
      </SectionContainer>
    </div>
  </main>
</Layout>

<style>
  .post-header {
    padding-top: 1rem;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .post-title {
    max-width: 24ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.1;
  }

  .post-lede {
    max-width: 52ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .post-meta {
    margin: 1.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .post-prose > :global(:first-child) {
    margin-top: 0;
  }

  .post-prose > :global(:last-child) {
    margin-bottom: 0;
  }

  .post-prose :global(p),
  .post-prose :global(ul),
  .post-prose :global(ol),
  .post-prose :global(h2),
  .post-prose :global(h3) {
    max-width: 68ch;
  }

  .post-prose :global(p) {
    margin: 0 0 1.25rem;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .post-prose :global(h2) {
    margin: 3rem 0 1rem;
    color: var(--text-strong);
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    scroll-margin-top: 6rem;
  }

  .post-prose :global(h3) {
    margin: 2rem 0 0.75rem;
    color: var(--text-strong);
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .post-prose :global(ul),
  .post-prose :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .post-prose :global(ul) {
    list-style: disc;
  }

  .post-prose :global(ol) {
    list-style: decimal;
  }

  .post-prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .post-prose :global(li > ul),
  .post-prose :global(li > ol) {
    margin: 0.5rem 0 0;
  }

  .post-prose :global(ul > li::marker) {
    color: var(--sky-signal);
  }

  .post-prose :global(ol > li::marker) {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .post-prose :global(a) {
    color: var(--text-body);
    text-decoration: underline;
    text-decoration-color: rgb(var(--sky-signal-rgb) / 0.7);
    text-underline-offset: 0.3em;
    border-radius: 0.25rem;
    transition: color 0.2s var(--ease-out);
  }

  .post-prose :global(a:hover) {
    color: var(--sky-accent);
  }

  .post-prose :global(a:focus-visible) {
    outline: 2px solid var(--sky-signal);
    outline-offset: 4px;
  }

  .post-prose :global(strong) {
    color: var(--text-strong);
    font-weight: 600;
  }

  .post-prose :global(a strong) {
    color: inherit;
  }

  .post-prose :global(em) {
    font-style: italic;
  }

  .post-prose :global(hr) {
    max-width: none;
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--hairline);
  }

  .post-prose :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
    text-align: left;
  }

  .post-prose :global(th),
  .post-prose :global(td) {
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--hairline-strong);
    vertical-align: top;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .post-prose :global(th) {
    background: var(--card-surface);
    color: var(--text-strong);
    font-weight: 600;
  }

  .post-prose :global(td) {
    color: var(--text-secondary);
  }

  .post-prose :global(td:first-child) {
    color: var(--text-body);
    font-weight: 600;
  }

  .post-prose :global(blockquote) {
    max-width: 68ch;
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 2px solid var(--sky-signal);
    color: var(--text-body);
  }

  .post-prose :global(blockquote p) {
    color: inherit;
  }

  .post-prose :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .post-prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--hairline);
    border-radius: 0.25rem;
    background: var(--card-surface);
    color: var(--text-body);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  .post-prose :global(a code) {
    color: inherit;
  }

  .post-prose :global(pre) {
    max-width: 100%;
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--hairline);
    border-radius: 0.9rem;
    /* Shiki writes the background inline; the ink surface must win. */
    background-color: var(--card-surface) !important;
    color: var(--text-body);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-prose :global(pre:focus-visible) {
    outline: 2px solid var(--sky-signal);
    outline-offset: 4px;
  }

  .post-prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: 0.9rem;
  }

  @media (max-width: 479px) {
    .post-prose :global(table) {
      font-size: 0.875rem;
    }

    .post-prose :global(th),
    .post-prose :global(td) {
      padding: 0.5rem 0.625rem;
    }

    .post-prose :global(pre) {
      padding: 0.875rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-prose :global(a) {
      transition: none;
    }
  }
</style>
