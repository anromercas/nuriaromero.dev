---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import WhatsAppButton from "../components/WhatsAppButton.astro"
import AnalyticsConsent from "../components/AnalyticsConsent.astro"
import SEO from "../components/seo/SEO.astro"
import Schema from "../components/seo/Schema.astro"
import { localBusinessSchema, websiteSchema } from "@/lib/schema"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogType?: "website" | "article"
  noindex?: boolean
}

const { title, description, canonical, ogImage, ogType, noindex } = Astro.props
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <Schema schema={[localBusinessSchema(), websiteSchema()]} />
    <slot name="head" />
    <ViewTransitions />
  </head>

  <body class="relative text-white">
    <AnalyticsConsent />
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <WhatsAppButton />
    <style is:global>
      :root {
        color-scheme: dark;
      }

      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        font-size: 106.25%;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      p,
      li {
        line-height: 1.7;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
