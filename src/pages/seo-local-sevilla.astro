---
import ServiceLayout from "@/layouts/ServiceLayout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import SeoLocalHero from "@/components/seo-local/SeoLocalHero.astro"
import ProofStrip from "@/components/seo-local/ProofStrip.astro"
import ReviewBento from "@/components/seo-local/ReviewBento.astro"
import BentoTile from "@/components/seo-local/BentoTile.astro"
import SeoLocalCycle from "@/components/seo-local/SeoLocalCycle.astro"
import SeoLocalProcess from "@/components/seo-local/SeoLocalProcess.astro"
import RealProof from "@/components/seo-local/RealProof.astro"
import SeoLocalAgencia from "@/components/seo-local/SeoLocalAgencia.astro"
import SeoLocalFaq from "@/components/seo-local/SeoLocalFaq.astro"
import SeoLocalRelated from "@/components/seo-local/SeoLocalRelated.astro"
import SeoLocalClosing from "@/components/seo-local/SeoLocalClosing.astro"
import SeoLocalNap from "@/components/seo-local/SeoLocalNap.astro"
import SeoLocalPlans from "@/components/seo-local/SeoLocalPlans.astro"
import ListingMock from "@/components/seo-local/ListingMock.astro"
import { seoLocal, tierFrom } from "@/data/services"
import { internalLinksBySource } from "@/data/internal-links"
import { SITE_PROOF } from "@/data/site"
import { getGoogleReviews } from "@/lib/google-reviews"

const reviewsData = await getGoogleReviews()

const agenciaItems = [
  {
    lead: "Una agencia SEO suele repartir tu cuenta entre varias personas: quien vende, quien coordina y quien ejecuta.",
    text: "Conmigo, como consultora SEO, hablas directamente con quien revisa tu ficha de Google y trabaja tu web.",
  },
  {
    lead: "Una agencia tiene más manos y puede llevar a la vez campañas, redes sociales y diseño.",
    text: "Si lo que necesitas es que tu negocio se entienda bien en Google y Google Maps, una consultora que domina la ficha y la parte técnica de la web suele ser suficiente.",
  },
  {
    lead: "Elijas lo que elijas, pide por escrito qué incluye cada mes y cuánto cuesta.",
    text: "Aquí lo tienes publicado: dos planes con su alcance, facturados mes a mes y sin promesas de posiciones.",
  },
]

const proofItems = [
  SITE_PROOF[0],
  ...(reviewsData
    ? [
        {
          stat: `${reviewsData.rating.toFixed(1).replace(".", ",")} en Google`,
          label: `${reviewsData.userRatingCount} ${reviewsData.userRatingCount === 1 ? "opinión" : "opiniones"}`,
        },
      ]
    : []),
  SITE_PROOF[1],
]
---

<ServiceLayout page={seoLocal} variant="template">
  <Fragment slot="hero">
    <SeoLocalHero
      keyword={seoLocal.hero.h1}
      title={{
        text: seoLocal.hero.title ?? seoLocal.hero.h1,
        accent: seoLocal.hero.titleAccent,
      }}
      subtitle={seoLocal.hero.subtitle}
      primaryCtaLabel={seoLocal.hero.primaryCtaLabel}
      secondaryLink={{ label: "Ver los planes", href: "#precios" }}
    >
      <ListingMock slot="visual" />
    </SeoLocalHero>
    <ProofStrip items={proofItems} />
  </Fragment>
  <Fragment slot="benefits">
    <SectionContainer id="revision-local">
      <ReviewBento
        headingId="revision-title"
        keyword="Posicionamiento web en Sevilla: Google y Google Maps"
        title={{ text: "Qué se revisa para que te encuentren", accent: "te encuentren" }}
      >
        <BentoTile
          area="a"
          title="Ficha de Google Business Profile"
          text="Categoría, servicios, horarios, descripción y señales visibles, revisados para que expliquen bien lo que haces."
        >
          <svg viewBox="0 40 360 150" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M44 120c-12-12-24-22-24-36a24 24 0 0 1 48 0c0 14-12 24-24 36z" class="signal"></path>
            <circle cx="44" cy="84" r="8" class="signal"></circle>
            <rect x="92" y="52" width="130" height="14" rx="7"></rect>
            <rect x="92" y="76" width="96" height="10" rx="5" class="soft"></rect>
            <rect x="236" y="46" width="112" height="30" rx="15" class="signal"></rect>
            <text x="292" y="67" text-anchor="middle" class="label">Categoría</text>
            <circle cx="104" cy="118" r="10"></circle>
            <path d="M104 111v7l5 3"></path>
            <rect x="124" y="113" width="110" height="10" rx="5" class="soft"></rect>
            <rect x="20" y="152" width="84" height="26" rx="13"></rect>
            <rect x="114" y="152" width="96" height="26" rx="13"></rect>
            <rect x="220" y="152" width="76" height="26" rx="13"></rect>
            <path d="M322 160l5 5 10-10" class="signal"></path>
          </svg>
        </BentoTile>
        <BentoTile
          area="b"
          title="Datos coherentes en directorios locales"
          text="Que nombre, dirección y teléfono coincidan en los lugares públicos donde la gente consulta tu negocio."
        >
          <svg viewBox="0 0 320 188" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="8" y="8" width="304" height="38" rx="8"></rect>
            <text x="22" y="33" class="label">Misma dirección</text>
            <circle cx="284" cy="27" r="10" class="signal"></circle>
            <path d="M279 27l3.5 3.5 6-6.5" class="signal"></path>
            <rect x="8" y="54" width="304" height="38" rx="8"></rect>
            <text x="22" y="79" class="label">Mismo teléfono</text>
            <circle cx="284" cy="73" r="10" class="signal"></circle>
            <path d="M279 73l3.5 3.5 6-6.5" class="signal"></path>
            <rect x="8" y="100" width="304" height="38" rx="8"></rect>
            <text x="22" y="125" class="label">Mismo nombre</text>
            <circle cx="284" cy="119" r="10" class="signal"></circle>
            <path d="M279 119l3.5 3.5 6-6.5" class="signal"></path>
            <rect x="8" y="146" width="304" height="34" rx="8" class="soft"></rect>
            <rect x="22" y="159" width="120" height="8" rx="4" class="soft"></rect>
          </svg>
        </BentoTile>
        <BentoTile
          area="c"
          title="Búsquedas locales en Sevilla"
          text="Cómo explicar tus servicios y zonas con las palabras que usa tu cliente cuando busca cerca."
        >
          <svg viewBox="0 0 320 300" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="8" y="8" width="304" height="40" rx="20" class="signal"></rect>
            <circle cx="32" cy="28" r="7" class="signal"></circle>
            <path d="M37 33l6 6" class="signal"></path>
            <text x="54" y="34" class="label strong">fontanero cerca de mí</text>
            <rect x="8" y="60" width="304" height="232" rx="10"></rect>
            <path d="M8 160c50-30 90 20 150-8s100-14 154-6" class="soft"></path>
            <path d="M120 60c-8 60 18 100 8 232" class="soft"></path>
            <path d="M220 60c10 50-12 90 6 232" class="soft"></path>
            <path d="M70 150c-6-7-10-12-10-17a10 10 0 0 1 20 0c0 5-4 10-10 17z" class="signal"></path>
            <path d="M170 210c-6-7-10-12-10-17a10 10 0 0 1 20 0c0 5-4 10-10 17z" class="signal"></path>
            <path d="M260 250c-6-7-10-12-10-17a10 10 0 0 1 20 0c0 5-4 10-10 17z" class="signal"></path>
            <path d="M240 110c-6-7-10-12-10-17a10 10 0 0 1 20 0c0 5-4 10-10 17z" class="signal"></path>
          </svg>
        </BentoTile>
        <BentoTile
          area="d"
          title="Reseñas de Google"
          text="Un proceso para pedir reseñas auténticas y responderlas, sin atajos."
        >
          <svg viewBox="0 0 320 130" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <polygon points="24 12 28 22 38 23 31 30 33 40 24 35 15 40 17 30 10 23 20 22" class="signal"></polygon>
            <polygon points="64 12 68 22 78 23 71 30 73 40 64 35 55 40 57 30 50 23 60 22" class="signal"></polygon>
            <polygon points="104 12 108 22 118 23 111 30 113 40 104 35 95 40 97 30 90 23 100 22" class="signal"></polygon>
            <polygon points="144 12 148 22 158 23 151 30 153 40 144 35 135 40 137 30 130 23 140 22" class="signal"></polygon>
            <polygon points="184 12 188 22 198 23 191 30 193 40 184 35 175 40 177 30 170 23 180 22" class="signal"></polygon>
            <rect x="8" y="56" width="190" height="20" rx="10" class="soft"></rect>
            <path d="M30 76l-4 8 12-8" class="soft"></path>
            <rect x="112" y="90" width="196" height="30" rx="12" class="signal"></rect>
            <path d="M280 120l6 8 2-8" class="signal"></path>
            <rect x="128" y="100" width="120" height="8" rx="4" class="signal"></rect>
          </svg>
        </BentoTile>
        <BentoTile
          area="e"
          title="Web para negocios locales"
          text="Qué conviene aclarar en la web para que personas y buscadores entiendan qué ofreces y dónde."
        >
          <svg viewBox="0 0 320 130" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="8" y="8" width="196" height="114" rx="10"></rect>
            <path d="M8 30h196"></path>
            <circle cx="22" cy="19" r="2.5"></circle>
            <circle cx="34" cy="19" r="2.5"></circle>
            <circle cx="46" cy="19" r="2.5"></circle>
            <rect x="22" y="42" width="110" height="12" rx="6" class="signal"></rect>
            <rect x="22" y="64" width="162" height="8" rx="4" class="soft"></rect>
            <rect x="22" y="80" width="140" height="8" rx="4" class="soft"></rect>
            <rect x="22" y="96" width="90" height="14" rx="7"></rect>
            <rect x="222" y="44" width="90" height="38" rx="19" class="signal"></rect>
            <text x="267" y="69" text-anchor="middle" class="label">datos</text>
          </svg>
        </BentoTile>
        <BentoTile
          area="f" layout="row"
          title="Medición de llamadas, clics y rutas"
          text="Qué acciones se pueden observar, como llamadas, clics y rutas, para decidir el siguiente paso."
        >
          <svg viewBox="0 0 320 150" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M8 120h304"></path>
            <rect x="24" y="44" width="56" height="76" rx="6" class="signal"></rect>
            <text x="52" y="142" text-anchor="middle" class="label">llamadas</text>
            <rect x="132" y="74" width="56" height="46" rx="6" class="signal"></rect>
            <text x="160" y="142" text-anchor="middle" class="label">clics</text>
            <rect x="240" y="20" width="56" height="100" rx="6" class="signal"></rect>
            <text x="268" y="142" text-anchor="middle" class="label">rutas</text>
          </svg>
        </BentoTile>
      </ReviewBento>
    </SectionContainer>
  </Fragment>
  <Fragment slot="process">
    <div class="band">
      <SectionContainer>
        <SeoLocalProcess
          headingId="proceso-title"
          keyword="Cómo trabajamos el SEO local en Sevilla"
          title={{ text: "Hablas con quien hace el trabajo", accent: "quien hace el trabajo" }}
          steps={seoLocal.process}
        >
          <Fragment slot="byline">Soy Nuria Romero, <a href="/">consultor SEO en Sevilla</a>, y llevo tu SEO local mes a mes.</Fragment>
          <SeoLocalCycle
            slot="aside"
            items={["Trabajo revisable", "Prioridades acordadas", "Vídeo-informe mensual"]}
            centre="cada mes"
          />
        </SeoLocalProcess>
      </SectionContainer>
    </div>
  </Fragment>
  <Fragment slot="before-pricing">
    <SectionContainer id="trabajo-real">
      <RealProof
        headingId="prueba-title"
        keyword="Webs de negocios locales en Sevilla"
        title={{ text: "Trabajo que puedes ver", accent: "puedes ver" }}
        reviews={reviewsData}
        note="Dos webs reales de negocios de Sevilla, hechas por mí. Puedes visitarlas y juzgar el trabajo por ti."
        projects={["arkady", "adfsevilla"]}
      />
    </SectionContainer>
    <SectionContainer>
      <SeoLocalAgencia
        headingId="agencia-title"
        keyword="¿Agencia SEO en Sevilla o consultora?"
        title={{ text: "Dos maneras de llevar tu SEO local", accent: "tu SEO local" }}
        items={agenciaItems}
        link={{ label: "Ver los planes y precios", href: "#precios" }}
      />
    </SectionContainer>
  </Fragment>
  <Fragment slot="pricing">
    <div class="band">
      <SectionContainer>
        <SeoLocalPlans
          headingId="planes-title"
          keyword="Cuánto cuesta el SEO local en Sevilla"
          title={{
            text: seoLocal.sectionTitles?.pricing ?? "Dos planes, con un alcance claro",
            accent: "un alcance claro",
          }}
          tiers={seoLocal.pricing.tiers ?? []}
          note={seoLocal.pricing.note}
        >
          <Fragment slot="lede">El SEO local en Sevilla cuesta <strong>{tierFrom(seoLocal, "Local")}</strong> con el plan Local, centrado en tu ficha de Google, y <strong>{tierFrom(seoLocal, "Local Pro")}</strong> con Local Pro, que suma el trabajo en tu web.</Fragment>
        </SeoLocalPlans>
      </SectionContainer>
    </div>
  </Fragment>
  <Fragment slot="faq">
    <SectionContainer>
      <SeoLocalFaq
        headingId="faq-title"
        keyword="Preguntas frecuentes sobre SEO local en Sevilla"
        title={{
          text: seoLocal.sectionTitles?.faq ?? "Preguntas antes de empezar",
          accent: "antes de empezar",
        }}
        lede="Si tu duda no está aquí, la resolvemos en la llamada."
        faqs={seoLocal.faqs}
        ctaLabel={seoLocal.cta?.buttonLabel}
      />
    </SectionContainer>
  </Fragment>
  <Fragment slot="related">
    <SectionContainer>
      <SeoLocalRelated links={internalLinksBySource[seoLocal.slug] ?? []} />
    </SectionContainer>
  </Fragment>
  <Fragment slot="closing">
    <SeoLocalClosing
      headingId="cierre-title"
      keyword="Reserva una llamada sobre SEO local en Sevilla"
      title={{ text: seoLocal.cta?.title ?? "", accent: "tu presencia local" }}
      text={seoLocal.cta?.text ?? ""}
      ctaLabel={seoLocal.cta?.buttonLabel}
    >
      <ListingMock slot="visual" animate={false} />
    </SeoLocalClosing>
    <SectionContainer>
      <SeoLocalNap
        headingId="nap-title"
        keyword="SEO local desde La Rinconada, Sevilla"
      />
    </SectionContainer>
  </Fragment>
</ServiceLayout>
