---
import ServiceLayout from "@/layouts/ServiceLayout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import SeoLocalHero from "@/components/seo-local/SeoLocalHero.astro"
import ProofStrip from "@/components/seo-local/ProofStrip.astro"
import ReviewBento from "@/components/seo-local/ReviewBento.astro"
import SeoLocalProcess from "@/components/seo-local/SeoLocalProcess.astro"
import RealProof from "@/components/seo-local/RealProof.astro"
import { seoLocal } from "@/data/services"
import { getGoogleReviews } from "@/lib/google-reviews"

const reviewsData = await getGoogleReviews()
---

<ServiceLayout page={seoLocal}>
  <Fragment slot="hero">
    <SeoLocalHero />
    <ProofStrip reviews={reviewsData} />
  </Fragment>
  <Fragment slot="benefits">
    <SectionContainer id="revision-local">
      <ReviewBento />
    </SectionContainer>
  </Fragment>
  <Fragment slot="process">
    <SectionContainer>
      <SeoLocalProcess />
    </SectionContainer>
  </Fragment>
  <Fragment slot="before-pricing">
    <SectionContainer id="trabajo-real">
      <RealProof reviews={reviewsData} />
    </SectionContainer>
  </Fragment>
</ServiceLayout>
