---
import ServiceLayout from "@/layouts/ServiceLayout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import SeoLocalHero from "@/components/seo-local/SeoLocalHero.astro"
import ProofStrip from "@/components/seo-local/ProofStrip.astro"
import ReviewBento from "@/components/seo-local/ReviewBento.astro"
import SeoLocalProcess from "@/components/seo-local/SeoLocalProcess.astro"
import RealProof from "@/components/seo-local/RealProof.astro"
import SeoLocalFaq from "@/components/seo-local/SeoLocalFaq.astro"
import SeoLocalRelated from "@/components/seo-local/SeoLocalRelated.astro"
import SeoLocalClosing from "@/components/seo-local/SeoLocalClosing.astro"
import SeoLocalNap from "@/components/seo-local/SeoLocalNap.astro"
import SeoLocalPlans from "@/components/seo-local/SeoLocalPlans.astro"
import { seoLocal } from "@/data/services"
import { getGoogleReviews } from "@/lib/google-reviews"

const reviewsData = await getGoogleReviews()
---

<ServiceLayout page={seoLocal}>
  <Fragment slot="hero">
    <SeoLocalHero />
    <ProofStrip reviews={reviewsData} />
  </Fragment>
  <Fragment slot="benefits">
    <SectionContainer id="revision-local">
      <ReviewBento />
    </SectionContainer>
  </Fragment>
  <Fragment slot="process">
    <div class="band">
      <SectionContainer>
        <SeoLocalProcess />
      </SectionContainer>
    </div>
  </Fragment>
  <Fragment slot="before-pricing">
    <SectionContainer id="trabajo-real">
      <RealProof reviews={reviewsData} />
    </SectionContainer>
  </Fragment>
  <Fragment slot="pricing">
    <div class="band">
      <SectionContainer>
        <SeoLocalPlans />
      </SectionContainer>
    </div>
  </Fragment>
  <Fragment slot="faq">
    <SectionContainer>
      <SeoLocalFaq />
    </SectionContainer>
  </Fragment>
  <Fragment slot="related">
    <SectionContainer>
      <SeoLocalRelated />
    </SectionContainer>
  </Fragment>
  <Fragment slot="closing">
    <SeoLocalClosing />
    <SectionContainer>
      <SeoLocalNap />
    </SectionContainer>
  </Fragment>
</ServiceLayout>

<style is:global>
  /* Route-local ground: keep the ink-blue hue down the whole page. */
  main {
    background-color: rgb(5 10 24);
    background-image: radial-gradient(ellipse 80% 30% at 50% 0%, rgb(56 189 248 / 0.1), transparent 70%);
  }

  .band {
    margin-inline: -1rem;
    padding: 3rem 1rem;
    border-block: 1px solid rgb(30 41 59);
    background: rgb(8 16 36 / 0.85);
  }
</style>
