---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Experience from "@/components/Experience.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import TitleSection from "@/components/TitleSection.astro"
import ContactForm from '../components/ContactForm.astro';
---

<Layout
  title="Porfolio de Nuria Romero - Desarrolladora y Programadora Web con +10 años de experiencia"
  description="Contrata a Nuria Romero para crear tu aplicación web o móvil. Desarrolladora Web y Soluciones de Automatización. Especializada en el desarrollo de soluciones a medida."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero>
      </slot>
    </Hero>
    </SectionContainer>
    <div class="space-y-24">
    <SectionContainer id="experiencia">
      <TitleSection>
        <Briefcase class="size-8" />
        Experiencia laboral
      </TitleSection>
      <Experience />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <TitleSection>
        <CodeIcon class="size-7" />
        Proyectos
      </TitleSection>
      <Projects />
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <TitleSection>
        <ProfileCheck class="size-8" />
        Sobre mí
      </TitleSection>
      <AboutMe />
    </SectionContainer>

    <SectionContainer id="contacto">
      <TitleSection>
        <ProfileCheck class="size-8" />
        Contacto
      </TitleSection>
      <ContactForm 
          title="Contáctame" 
          description="¿Tienes alguna pregunta? Envíame un mensaje y me pondré en contacto contigo."
        />
    </SectionContainer>
  </div>
  </main>
</Layout>
