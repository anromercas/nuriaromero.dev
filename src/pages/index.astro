---
import Layout from "@/layouts/Layout.astro";
import Schema from "@/components/seo/Schema.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import SeoLocalHero from "@/components/seo-local/SeoLocalHero.astro";
import ProofStrip from "@/components/seo-local/ProofStrip.astro";
import ReviewBento from "@/components/seo-local/ReviewBento.astro";
import BentoTile from "@/components/seo-local/BentoTile.astro";
import SeoLocalProcess from "@/components/seo-local/SeoLocalProcess.astro";
import RealProof from "@/components/seo-local/RealProof.astro";
import SeoLocalAgencia from "@/components/seo-local/SeoLocalAgencia.astro";
import SeoLocalFaq from "@/components/seo-local/SeoLocalFaq.astro";
import SeoLocalRelated from "@/components/seo-local/SeoLocalRelated.astro";
import SeoLocalClosing from "@/components/seo-local/SeoLocalClosing.astro";
import SeoLocalNap from "@/components/seo-local/SeoLocalNap.astro";
import HomeHeroMock from "@/components/home/HomeHeroMock.astro";
import ServiceTileArt from "@/components/home/ServiceTileArt.astro";
import type { ComparisonItem, Step } from "@/components/seo-local/types";
import { internalLinksBySource } from "@/data/internal-links";
import { SITE_PROOF } from "@/data/site";
import { faqSchema, personSchema, reviewsSchema } from "@/lib/schema";
import { getGoogleReviews } from "@/lib/google-reviews";
import {
  seoLocal,
  disenoWeb,
  tiendaOnline,
  desarrolloSoftware,
  automatizaciones,
  inteligenciaArtificial,
  tierFrom,
} from "@/data/services";

const reviewsData = await getGoogleReviews();

const homeDescription = `Consultor SEO en Sevilla para negocios locales: aparece en Google, Maps y en las respuestas de IA. SEO local desde ${tierFrom(seoLocal, "Local")} y trato directo.`;

const proofItems = [
  SITE_PROOF[0],
  ...(reviewsData
    ? [
        {
          stat: `${reviewsData.rating.toFixed(1).replace(".", ",")} en Google`,
          label: `${reviewsData.userRatingCount} ${reviewsData.userRatingCount === 1 ? "opinión" : "opiniones"}`,
        },
      ]
    : []),
  SITE_PROOF[1],
];

const homeProcess: Step[] = [
  {
    title: "Me cuentas tu caso",
    text: "Una primera sesión para entender tu negocio y qué te frena hoy.",
  },
  {
    title: "Propuesta por escrito",
    text: "Precio, alcance y plazos cerrados antes de empezar.",
  },
  {
    title: "Avances a la vista",
    text: "Ves cómo avanza el trabajo y opinas por el camino, no solo al final.",
  },
  {
    title: "Lanzamiento y seguimiento",
    text: "Publico, te enseño a manejarlo y sigo disponible; en SEO local, mes a mes.",
  },
];

const comparison: ComparisonItem[] = [
  {
    lead: "Con una agencia, tu cuenta suele pasar por varias personas.",
    text: "Conmigo hablas directamente con quien revisa tu ficha y trabaja tu web.",
  },
  {
    lead: "Una agencia tiene más manos para campañas, redes y diseño a la vez.",
    text: "Si lo que necesitas es que Google entienda bien tu negocio, una consultora con base técnica suele bastar.",
  },
  {
    lead: "Elijas lo que elijas, pide por escrito qué incluye cada mes.",
    text: "Mis planes de SEO local están publicados, con precio y alcance, y sin promesas de posiciones.",
  },
];

const homeFaqs = [
  {
    q: "¿Qué es el SEO local y el GEO, y en qué se diferencian de tener una web?",
    a: "Es el trabajo que hace que tu negocio aparezca en Google y en Google Maps cuando alguien busca cerca de ti lo que ofreces — por ejemplo, cuando alguien escribe 'clínica dental Nervión' o 'restaurante cerca de mí'. Es lo mismo, pero para las nuevas formas de buscar: cuando alguien le pregunta a ChatGPT, al modo IA de Google o a otro asistente qué negocio de tu tipo hay en tu zona, trabajo para que el tuyo esté entre las respuestas que da. Tener una web es necesaria para que la gente te encuentre y pueda contactarte, pero no garantiza que aparezcas cuando alguien busca tu tipo de negocio: eso es precisamente el trabajo del SEO local y el GEO, que puedo hacer sobre la web que ya tengas.",
  },
  {
    q: "¿Cuánto cuesta una página web para un negocio en Sevilla?",
    a: "Una web completa de hasta 5 páginas parte de 399 €, e incluye diseño a medida adaptado a móvil, SEO local trabajado desde el código, creación y configuración del dominio y hosting (su coste corre por tu cuenta, porque quedan a tu nombre), botón de WhatsApp y formulario de contacto, alta en Google y Google Maps, y un mes de soporte tras el lanzamiento. Si solo necesitas una landing de una página optimizada para SEO y GEO, el precio de salida es de 149 €. En ambos casos trabajo siempre con presupuesto cerrado: te envío una propuesta por escrito con el precio y los plazos antes de empezar, así que sabes el coste exacto desde el primer momento y no hay sorpresas después. El presupuesto final se ajusta al alcance real de tu proyecto, pero ese ajuste también queda por escrito antes de que empecemos a trabajar. Si más adelante quieres automatizar tareas o añadir un chatbot con inteligencia artificial, esos servicios parten de 149 € y 399 € respectivamente.",
  },
  {
    q: "¿Qué diferencia hay entre tu trabajo y una web de plantilla?",
    a: "Soy desarrolladora de software con más de 10 años de experiencia, no una plantilla montada en un día: he trabajado en proyectos para industria, salud y medioambiente, y como consultora en NTT DATA, antes de dedicarme a webs para negocios locales. Esa base técnica se traduce en un enfoque medible: construyo cada web pensando en la velocidad de carga y en los Core Web Vitals de Google desde el primer día, con el SEO local trabajado desde el código, con estructura, velocidad y datos estructurados pensados desde el principio, no añadidos después con un plugin. Una plantilla genérica suele arrastrar código innecesario que ralentiza la carga y complica el posicionamiento, y te deja atada a las limitaciones del constructor. Con tu web, el dominio y el hosting quedan a tu nombre desde el primer año, sin cuotas ocultas ni depender de una plataforma cerrada si el día de mañana quieres moverla. Esa diferencia técnica es la que ayuda a que tu web tenga más opciones frente a negocios con webs de plantilla.",
  },
  {
    q: "¿Trabajas solo el diseño web?",
    a: "No: además del diseño web también desarrollo software a medida, automatizaciones con n8n y Make, y soluciones con inteligencia artificial como chatbots de atención al cliente. El software a medida, desde 999 €, sustituye a los Excels y programas genéricos que se quedan cortos, con herramientas de gestión de pedidos, reservas o facturación pensadas para tu negocio y no al revés. Las automatizaciones, desde 149 €, conectan las aplicaciones que ya usas (correo, WhatsApp, hojas de cálculo, facturación) para que tareas repetitivas como confirmar citas o generar facturas se hagan solas, sin errores. Y los chatbots con inteligencia artificial, desde 399 €, atienden a tus clientes fuera de horario, entrenados únicamente con la información de tu negocio. Muchos clientes empiezan pidiendo la web y, una vez ven cómo trabajo, deciden automatizar otras partes de su negocio en un segundo proyecto. Todos estos servicios siguen el mismo proceso de trabajo y el mismo presupuesto cerrado que la web.",
  },
  {
    q: "¿Cómo empiezo?",
    a: "Reserva una primera sesión y cuéntame qué negocio tienes y qué necesitas, con tus propias palabras y sin tecnicismos. En esa conversación entiendo tu caso y, después, te envío una propuesta por escrito con el precio y los plazos cerrados. Si la aceptas, empezamos el diseño y desarrollo compartiendo avances por el camino, revisamos juntas el resultado y ajusto lo que haga falta antes del lanzamiento.",
  },
  {
    q: "¿Trabajar con una freelance en vez de una agencia es un riesgo?",
    a: "Es una objeción razonable, y prefiero responderte con sinceridad en vez de venderte algo que no puedo garantizar al cien por cien: cualquier profesional, freelance o de agencia, puede dejar de estar disponible en algún momento. Lo que sí controlas trabajando conmigo es que no dependes técnicamente de mí. El dominio y el hosting de tu web quedan a tu nombre desde el primer año, y en software a medida y automatizaciones te lo dejo explícito por escrito: el código y la documentación son tuyos, y si algún día quieres que lo continúe otro profesional, podrá hacerlo sin problema. Además, cada proyecto incluye soporte tras el lanzamiento (un mes en el caso de las webs) y varias formas de contactarme: WhatsApp, teléfono, email o LinkedIn. Y llevo más de 10 años trabajando en desarrollo de software, con experiencia en consultoras como NTT DATA además de con negocios locales. No es la misma estructura que una agencia, pero tampoco te deja atada de manos.",
  },
];
---

<Layout
  title="Consultor SEO en Sevilla | Nuria Romero, SEO local y para IA"
  description={homeDescription}
>
  <Schema
    slot="head"
    schema={[
      personSchema(),
      faqSchema(homeFaqs),
      ...(reviewsData ? [reviewsSchema(reviewsData)] : []),
    ]}
  />
  <main class="template-ground px-4 pt-24">
    <div class="space-y-24">
      <SectionContainer
        id="home-hero"
        class="seo12-home-hero"
        data-seo12-hero="true"
      >
        <SeoLocalHero
          keyword="Consultor SEO en Sevilla para negocios locales"
          title={{
            text: "Que tu próximo cliente te encuentre a ti",
            accent: "te encuentre a ti",
          }}
          subtitle="Soy Nuria Romero, consultor SEO en Sevilla y desarrolladora web. Trabajo tu ficha de Google, tu web y cómo apareces en las respuestas de IA, y hablas siempre conmigo."
          secondaryLink={{ label: "Ver qué hago", href: "#que-hago" }}
          actionsAttrs={{ "data-seo12-primary-cta": "" }}
        >
          <HomeHeroMock slot="visual" />
        </SeoLocalHero>
        <ProofStrip items={proofItems} />
      </SectionContainer>

      <SectionContainer id="que-hago">
        <ReviewBento
          headingId="que-hago-title"
          keyword="Servicios para negocios locales en Sevilla"
          title={{
            text: "Lo que puedo hacer por tu negocio",
            accent: "por tu negocio",
          }}
        >
          <BentoTile
            area="a"
            title="Que te encuentren cerca"
            text="Ordeno tu ficha de Google y tu web para que te encuentren en Google, en Maps y en las respuestas de IA."
            link={{ label: seoLocal.breadcrumbName, href: seoLocal.slug }}
          >
            <ServiceTileArt kind="seo-local" />
          </BentoTile>
          <BentoTile
            area="b"
            title="Una web que se entiende"
            text="Webs claras y rápidas, pensadas para el móvil y preparadas para que te encuentren."
            link={{ label: disenoWeb.breadcrumbName, href: disenoWeb.slug }}
          >
            <ServiceTileArt kind="diseno-web" />
          </BentoTile>
          <BentoTile
            area="c"
            title="Vender por internet"
            text="Vende tus productos desde una tienda propia, fácil de gestionar en tu día a día."
            link={{
              label: tiendaOnline.breadcrumbName,
              href: tiendaOnline.slug,
            }}
          >
            <ServiceTileArt kind="tienda-online" />
          </BentoTile>
          <BentoTile
            area="d"
            title="Herramientas a tu medida"
            text="Programas hechos para tu negocio cuando las hojas de cálculo y el software genérico se quedan cortos."
            link={{
              label: desarrolloSoftware.breadcrumbName,
              href: desarrolloSoftware.slug,
            }}
          >
            <ServiceTileArt kind="software" />
          </BentoTile>
          <BentoTile
            area="e"
            title="Menos tareas repetitivas"
            text="Conecto las aplicaciones que ya usas para que las tareas repetitivas se hagan solas."
            link={{
              label: automatizaciones.breadcrumbName,
              href: automatizaciones.slug,
            }}
          >
            <ServiceTileArt kind="automatizaciones" />
          </BentoTile>
          <BentoTile
            area="f"
            layout="row"
            title="Respuestas a cualquier hora"
            text="Asistentes con IA que responden las dudas frecuentes de tus clientes con la información de tu negocio."
            link={{
              label: inteligenciaArtificial.breadcrumbName,
              href: inteligenciaArtificial.slug,
            }}
          >
            <ServiceTileArt kind="ia" />
          </BentoTile>
        </ReviewBento>
      </SectionContainer>

      <div class="band">
        <SectionContainer id="proceso">
          <SeoLocalProcess
            headingId="proceso-title"
            keyword="Cómo trabajo contigo, paso a paso"
            title={{
              text: "Sin intermediarios, de principio a fin",
              accent: "de principio a fin",
            }}
            steps={homeProcess}
            portraitAlt="Nuria Romero, consultor SEO en Sevilla y desarrolladora web"
          >
            <Fragment slot="byline">
              Soy Nuria Romero: llevo más de 10 años desarrollando software y
              ahora trabajo con negocios de Sevilla.
            </Fragment>
          </SeoLocalProcess>
        </SectionContainer>
      </div>

      <SectionContainer id="trabajo-real">
        <RealProof
          headingId="prueba-title"
          keyword="Opiniones y proyectos reales en Sevilla"
          title={{ text: "Trabajo que puedes ver", accent: "puedes ver" }}
          reviews={reviewsData}
          note="Dos webs reales de negocios de Sevilla, hechas por mí. Visítalas y juzga el trabajo por ti."
          projects={["arkady", "adfsevilla"]}
        />
      </SectionContainer>

      <SectionContainer>
        <SeoLocalAgencia
          id="consultor-o-agencia"
          headingId="consultor-title"
          keyword="¿Consultor SEO o agencia?"
          title={{ text: "Dos formas de llevar tu SEO", accent: "tu SEO" }}
          items={comparison}
          link={{
            label: "Ver los planes de SEO local",
            href: "/seo-local-sevilla/#precios",
          }}
        />
      </SectionContainer>

      <SectionContainer>
        <SeoLocalFaq
          headingId="faq-title"
          keyword="Preguntas frecuentes sobre SEO"
          title={{ text: "Dudas antes de llamar", accent: "antes de llamar" }}
          lede="Si tu duda no está aquí, la resolvemos en la llamada."
          faqs={homeFaqs}
          ctaLabel="Reserva una primera sesión"
        />
      </SectionContainer>

      <SectionContainer>
        <SeoLocalRelated links={internalLinksBySource["/"] ?? []} />
      </SectionContainer>

      <SeoLocalClosing
        headingId="cierre-title"
        keyword="Reserva una primera sesión conmigo"
        title={{
          text: "Hablemos de cómo te encuentran tus clientes",
          accent: "tus clientes",
        }}
        text="Cuéntame cómo es tu negocio y te diré qué tiene sentido hacer primero, sin compromiso."
        ctaLabel="Reserva una primera sesión"
      >
        <HomeHeroMock slot="visual" animate={false} />
      </SeoLocalClosing>

      <SectionContainer>
        <SeoLocalNap
          headingId="nap-title"
          keyword="Dónde trabajo: La Rinconada, Sevilla"
        />
      </SectionContainer>
    </div>
  </main>
</Layout>
