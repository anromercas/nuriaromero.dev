---
import Layout from "@/layouts/Layout.astro"
import Schema from "@/components/seo/Schema.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import TitleSection from "@/components/TitleSection.astro"
import Projects from "@/components/Projects.astro"
import FAQ from "@/components/services/FAQ.astro"
import CTASection from "@/components/services/CTASection.astro"
import SocialPill from "@/components/SocialPill.astro"
import Badge from "@/components/Badge.astro"
import WhatsAppIcon from "@/components/icons/WhatsApp.astro"
import MailIcon from "@/components/icons/Mail.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import { faqSchema, personSchema } from "@/lib/schema"
import { services } from "@/data/services"
import { niches } from "@/data/niches"
import { whatsappUrl } from "@/data/site"

const homeFaqs = [
  {
    q: "¿Cuánto cuesta una página web para un negocio en Sevilla?",
    a: "Una web completa de hasta 5 páginas parte de 399 €, con diseño a medida, SEO local, dominio y hosting el primer año incluidos. Si solo necesitas una landing de una página optimizada para SEO y GEO, desde 149 €. Siempre trabajo con presupuesto cerrado: sabes el precio exacto antes de empezar.",
  },
  {
    q: "¿Qué diferencia hay entre tu trabajo y una web de plantilla?",
    a: "Soy desarrolladora de software con más de 10 años de experiencia, no solo monto plantillas. Mis webs cargan en menos de 2 segundos, pasan los Core Web Vitals de Google y llevan el SEO local trabajado desde el código. Esa base técnica es la que hace que Google te ponga por delante de tu competencia.",
  },
  {
    q: "¿Trabajas solo el diseño web?",
    a: "No: también desarrollo software a medida, automatizaciones con n8n y Make, y soluciones con inteligencia artificial como chatbots de atención al cliente. Muchos clientes empiezan con la web y luego automatizan otras partes de su negocio.",
  },
  {
    q: "¿Cómo empiezo?",
    a: "Escríbeme por WhatsApp o por el formulario contándome qué negocio tienes y qué necesitas. Te respondo en menos de 24 horas laborables con los siguientes pasos y, tras una llamada breve, recibes una propuesta con precio y plazos cerrados.",
  },
]
---

<Layout
  title="Diseño de páginas web para negocios en Sevilla | Nuria Romero"
  description="Creo páginas web para negocios en Sevilla que aparecen en Google y traen clientes. También software a medida, automatizaciones e IA. Precios claros y trato directo."
>
  <Schema slot="head" schema={[personSchema(), faqSchema(homeFaqs)]} />
  <main class="px-4">
    <SectionContainer class="py-24 md:py-32">
      <div class="flex flex-col items-start">
        <a href="/contacto" rel="noopener" class="flex transition md:hover:scale-105 mb-4">
          <Badge>Aceptando nuevos proyectos</Badge>
        </a>
        <h1
          class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white mb-6"
        >
          Diseño de páginas web para negocios en Sevilla
        </h1>
        <p
          class="text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300 max-w-2xl"
        >
          Soy Nuria Romero, <strong>desarrolladora con más de 10 años de experiencia</strong>.
          Creo webs rápidas que aparecen en Google cuando tus clientes buscan lo
          que ofreces, y automatizo las tareas que te roban tiempo. Precios
          claros y trato directo, sin intermediarios.
        </p>
        <nav class="flex flex-wrap gap-4 mt-8">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-1 text-white transition bg-green-600 border border-green-700 rounded-full text-md hover:bg-green-500 max-w-fit focus:outline-none focus-visible:ring focus-visible:ring-green-500/80 focus-visible:ring-offset-2"
          >
            <WhatsAppIcon class="size-4" />
            Escríbeme por WhatsApp
          </a>
          <SocialPill href="/contacto">
            <MailIcon class="size-4" />
            Pide presupuesto gratis
          </SocialPill>
        </nav>
      </div>
    </SectionContainer>

    <div class="space-y-24">
      <SectionContainer id="servicios">
        <TitleSection>
          <Briefcase class="size-8" />
          ¿Qué necesita tu negocio?
        </TitleSection>
        <ul class="grid gap-6 sm:grid-cols-2">
          {
            services.map((service) => (
              <li>
                <a
                  href={service.slug}
                  class="block h-full rounded-xl border border-gray-300 bg-gray-100/50 p-6 transition hover:border-blue-500 hover:shadow-lg dark:border-gray-700 dark:bg-gray-800/50 dark:hover:border-blue-500"
                >
                  <h3 class="mb-2 text-xl font-semibold text-gray-800 dark:text-gray-100">
                    {service.breadcrumbName}
                  </h3>
                  <p class="text-gray-700 dark:text-gray-400">
                    {service.seo.description}
                  </p>
                  <span class="mt-4 inline-block font-medium text-blue-600 dark:text-blue-400">
                    Ver servicio →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-gray-700 dark:text-gray-400">
          ¿Tienes un restaurante, una clínica, un comercio o un despacho?
          Mira lo que puedo hacer por tu sector:
        </p>
        <ul class="mt-4 flex flex-wrap gap-3">
          {
            niches.map((niche) => (
              <li>
                <a
                  href={niche.slug}
                  class="inline-block rounded-full border border-gray-300 bg-gray-100/50 px-4 py-1.5 text-sm font-medium text-gray-800 transition hover:border-blue-500 hover:text-blue-500 dark:border-gray-600 dark:bg-gray-800/50 dark:text-gray-200"
                >
                  {niche.breadcrumbName}
                </a>
              </li>
            ))
          }
        </ul>
      </SectionContainer>

      <SectionContainer id="casos">
        <TitleSection>
          <CodeIcon class="size-7" />
          Casos reales
        </TitleSection>
        <p class="mb-12 text-gray-700 dark:text-gray-400 max-w-2xl">
          Webs de negocios de Sevilla que ya están funcionando y posicionando
          en Google:
        </p>
        <Projects />
      </SectionContainer>

      <SectionContainer id="faq">
        <TitleSection>
          <ProfileCheck class="size-8" />
          Preguntas frecuentes
        </TitleSection>
        <FAQ faqs={homeFaqs} />
      </SectionContainer>

      <SectionContainer>
        <CTASection
          title="Tu competencia ya está en Google"
          text="Cada día sin web posicionada es un cliente que se lleva otro. Cuéntame tu caso y te digo cómo empezar, sin compromiso."
        />
      </SectionContainer>
    </div>
  </main>
</Layout>
