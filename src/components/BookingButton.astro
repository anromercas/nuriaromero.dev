---
import CalendarIcon from "@/components/icons/Calendar.astro"
import { bookingUrl } from "@/data/site"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<a
  href={bookingUrl}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full border border-blue-700 bg-blue-600 px-4 py-2 font-medium text-white shadow-sm transition hover:bg-blue-500 focus:outline-none focus-visible:ring focus-visible:ring-blue-500/80 focus-visible:ring-offset-2 dark:border-blue-400 dark:bg-blue-500 dark:hover:bg-blue-400",
    className,
  ]}
>
  <CalendarIcon class="size-4" aria-hidden="true" />
  Reserva una primera sesión
</a>
