---
import BookingButton from "@/components/BookingButton.astro";

interface Option {
  id: string;
  name: string;
  example?: string;
  recurringCost: string;
}

interface ScopeItem {
  text: string;
  link?: { label: string; href: string };
}

interface Props {
  from: string;
  options: Option[];
  includes: string[];
  quotedSeparately: ScopeItem[];
  note: string;
}

const { from, options, includes, quotedSeparately, note } = Astro.props;
---

<div>
  <p>
    <span class="block text-gray-300">Desde</span>
    <span class="block text-4xl font-bold text-white">{from}</span>
  </p>
  <p class="mt-3 max-w-prose text-gray-300">
    Eliges la plataforma: las tres opciones parten del mismo precio.
  </p>

  <ul
    aria-label="Opciones de plataforma"
    class="mt-8 grid gap-4 sm:grid-cols-3"
  >
    {options.map((option) => (
      <li class="rounded-xl border border-gray-700 bg-gray-800/50 p-5">
        <h3 class="text-lg font-semibold text-gray-100">{option.name}</h3>
        {option.example && (
          <p class="mt-1 text-sm text-gray-400">{option.example}</p>
        )}
        <p class="mt-3 text-sm text-gray-300">{option.recurringCost}</p>
      </li>
    ))}
  </ul>

  <div class="mt-8 grid gap-8 md:grid-cols-2">
    <div>
      <h3 class="mb-3 text-lg font-semibold text-gray-100">Qué incluye</h3>
      <ul class="space-y-2 text-gray-300">
        {includes.map((item) => (
          <li class="flex gap-x-2">
            <span class="text-green-400" aria-hidden="true">
              ✓
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="mb-3 text-lg font-semibold text-gray-100">
        Se presupuesta aparte
      </h3>
      <ul class="space-y-2 text-gray-300">
        {quotedSeparately.map((item) => (
          <li class="flex gap-x-2">
            <span class="text-gray-500" aria-hidden="true">
              +
            </span>
            <span>
              {item.text}
              {item.link && (
                <a
                  href={item.link.href}
                  class="mt-1 block w-fit rounded-sm text-blue-400 underline underline-offset-4 hover:text-blue-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
                >
                  {item.link.label}
                </a>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="mt-8 text-sm text-gray-400">{note}</p>
  <div class="mt-6">
    <BookingButton />
  </div>
</div>
