---
// Single-stroke drawings for the "qué incluye tu tienda" bento tiles. Colours come
// from BentoTile (.signal, .soft, .strong), so the drawings carry no style of their own.
interface Props {
  kind: "catalogo" | "pago" | "variantes" | "envios" | "panel" | "seo";
}

const { kind } = Astro.props;
---

{kind === "catalogo" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="8" y="14" width="92" height="102" rx="10"></rect>
    <rect x="20" y="26" width="68" height="44" rx="6" class="soft"></rect>
    <rect x="20" y="80" width="52" height="8" rx="4" class="soft"></rect>
    <rect x="20" y="96" width="30" height="8" rx="4" class="soft"></rect>
    <rect x="114" y="14" width="92" height="102" rx="10" class="signal"></rect>
    <rect x="126" y="26" width="68" height="44" rx="6" class="signal"></rect>
    <rect x="126" y="80" width="52" height="8" rx="4" class="soft"></rect>
    <rect x="126" y="96" width="30" height="8" rx="4" class="soft"></rect>
    <rect x="220" y="14" width="92" height="102" rx="10"></rect>
    <rect x="232" y="26" width="68" height="44" rx="6" class="soft"></rect>
    <rect x="232" y="80" width="52" height="8" rx="4" class="soft"></rect>
    <rect x="232" y="96" width="30" height="8" rx="4" class="soft"></rect>
  </svg>
)}
{kind === "pago" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <g transform="rotate(-6 100 65)">
      <rect x="28" y="22" width="150" height="90" rx="10"></rect>
      <rect x="44" y="38" width="26" height="20" rx="4" class="signal"></rect>
      <rect x="44" y="72" width="80" height="8" rx="4" class="soft"></rect>
      <rect x="44" y="88" width="48" height="8" rx="4" class="soft"></rect>
    </g>
    <circle cx="246" cy="65" r="34" class="signal"></circle>
    <path d="M230 66l11 11 21-23" class="signal"></path>
  </svg>
)}
{kind === "variantes" && (
  <svg
    viewBox="0 0 160 230"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M44 18l-28 16 10 22 14-6v62h80V50l14 6 10-22-28-16a22 22 0 0 1-44 0z"
      transform="translate(-10 0)"
    ></path>
    <rect x="22" y="136" width="30" height="18" rx="9"></rect>
    <rect x="65" y="136" width="30" height="18" rx="9" class="signal"></rect>
    <rect x="108" y="136" width="30" height="18" rx="9"></rect>
    <circle cx="37" cy="190" r="10"></circle>
    <circle cx="80" cy="190" r="10"></circle>
    <circle cx="80" cy="190" r="16" class="signal"></circle>
    <circle cx="123" cy="190" r="10"></circle>
  </svg>
)}
{kind === "envios" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 38l40-16 40 16v50l-40 16-40-16z"></path>
    <path d="M12 38l40 16 40-16M52 54v50"></path>
    <path d="M104 66h104" class="soft" stroke-dasharray="4 6"></path>
    <circle cx="156" cy="66" r="7" class="signal"></circle>
    <path d="M224 56l16-22h40l16 22"></path>
    <path d="M228 56h72v54h-72z"></path>
    <rect x="252" y="80" width="24" height="30" rx="3" class="soft"></rect>
  </svg>
)}
{kind === "panel" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="8" y="10" width="304" height="110" rx="10"></rect>
    <rect x="8" y="10" width="64" height="110" rx="10" class="soft"></rect>
    <rect x="84" y="24" width="24" height="24" rx="4" class="soft"></rect>
    <rect x="120" y="30" width="110" height="8" rx="4"></rect>
    <rect x="252" y="28" width="48" height="14" rx="7" class="signal"></rect>
    <rect x="84" y="60" width="24" height="24" rx="4" class="soft"></rect>
    <rect x="120" y="66" width="90" height="8" rx="4"></rect>
    <rect x="252" y="64" width="48" height="14" rx="7" class="soft"></rect>
    <rect x="84" y="96" width="24" height="16" rx="4" class="soft"></rect>
    <rect x="120" y="100" width="100" height="8" rx="4"></rect>
    <rect x="252" y="98" width="48" height="12" rx="6" class="soft"></rect>
  </svg>
)}
{kind === "seo" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="8" y="14" width="168" height="84" rx="10"></rect>
    <rect x="24" y="30" width="110" height="12" rx="6" class="signal"></rect>
    <rect x="24" y="54" width="136" height="8" rx="4" class="soft"></rect>
    <rect x="24" y="70" width="104" height="8" rx="4" class="soft"></rect>
    <path d="M134 36h26c20 0 30 10 30 28" class="soft"></path>
    <rect x="200" y="64" width="112" height="56" rx="10"></rect>
    <rect x="212" y="76" width="36" height="32" rx="6" class="soft"></rect>
    <rect x="258" y="80" width="42" height="8" rx="4" class="soft"></rect>
    <rect x="258" y="96" width="28" height="8" rx="4" class="soft"></rect>
  </svg>
)}
