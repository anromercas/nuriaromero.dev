---
const personalImageAlt = "Nuria Romero";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
---

<div>
  <div
    class="flex flex-wrap sm:flex-wrap md:flex-wrap lg:flex-nowrap gap-4 mb-4 items-center"
  >
    <img
      class="size-1/2"
      src="/perfil-profesional.webp"
      alt={personalImageAlt}
    />
    <div class="flex flex-col">
      <h1
        class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white mb-4"
      >
        Hey, soy Nuria Romero
      </h1>
      <a
        href="/contacto"
        rel="noopener"
        class="flex transition md:hover:scale-105"
      >
        <Badge>Disponible para trabajar</Badge>
      </a>
      <p
        class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
      >
        +10 años de experiencia. <strong
          >Desarrolladora de Software y automatizaciones con herramientas
          low-code,</strong
        > de Sevilla, España. Especializada en el desarrollo de soluciones a medida.
      </p>
      <nav class="flex flex-wrap gap-4 mt-8">
        <SocialPill href="/contacto">
          <MailIcon class="size-4" />
          Contáctame
        </SocialPill>
        <SocialPill
          href="https://linkedin.com/in/nuria-romero-castillo"
          target="_blank"
        >
          <LinkedInIcon class="size-4" />
          LinkedIn
        </SocialPill>
      </nav>
    </div>
  </div>
</div>
