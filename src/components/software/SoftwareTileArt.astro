---
// Single-stroke drawings for the "qué software a medida puedo hacer" bento tiles.
// Colours come from BentoTile (.signal, .soft), so the drawings carry no style of
// their own. Generic shapes only: no brand logos, no figures, no SVG text.
interface Props {
  kind: "web" | "movil" | "gestion" | "api" | "reservas" | "datos";
}

const { kind } = Astro.props;
---

{kind === "web" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="40" y="10" width="240" height="110" rx="10"></rect>
    <path d="M40 34h240" class="soft"></path>
    <circle cx="56" cy="22" r="3"></circle>
    <circle cx="68" cy="22" r="3"></circle>
    <circle cx="80" cy="22" r="3"></circle>
    <rect x="98" y="17" width="120" height="10" rx="5" class="soft"></rect>
    <rect x="56" y="44" width="208" height="14" rx="4" class="signal"></rect>
    <rect x="56" y="68" width="160" height="7" rx="3.5" class="soft"></rect>
    <rect x="56" y="84" width="190" height="7" rx="3.5" class="soft"></rect>
    <rect x="56" y="100" width="130" height="7" rx="3.5" class="soft"></rect>
  </svg>
)}
{kind === "movil" && (
  <svg
    viewBox="0 0 160 230"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="40" y="8" width="80" height="214" rx="14"></rect>
    <path d="M68 18h24" class="soft"></path>
    <rect x="52" y="34" width="56" height="30" rx="6" class="soft"></rect>
    <rect x="52" y="72" width="56" height="30" rx="6" class="soft"></rect>
    <rect x="52" y="110" width="56" height="30" rx="6" class="soft"></rect>
    <rect x="56" y="182" width="48" height="22" rx="11" class="signal"></rect>
  </svg>
)}
{kind === "gestion" && (
  <svg
    viewBox="0 0 160 230"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="14" y="14" width="132" height="202" rx="12" class="signal"></rect>
    <path d="M34 46h40v36H34zM34 46l20-14 20 14M54 32v14" class="soft"></path>
    <path d="M34 106h36l10 10v40H34zM70 106v10h10" class="soft"></path>
    <path d="M44 126h26M44 140h26" class="soft"></path>
    <path d="M96 174v32l-6-5-6 5-6-5-6 5-6-5v-32z" class="soft"></path>
    <path d="M44 184h26" class="soft"></path>
  </svg>
)}
{kind === "api" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="12" y="20" width="96" height="90" rx="8"></rect>
    <path d="M12 42h96" class="soft"></path>
    <rect x="24" y="54" width="60" height="7" rx="3.5" class="soft"></rect>
    <rect x="24" y="70" width="40" height="7" rx="3.5" class="soft"></rect>
    <rect x="212" y="20" width="96" height="90" rx="8"></rect>
    <path d="M212 42h96" class="soft"></path>
    <rect x="224" y="54" width="60" height="7" rx="3.5" class="soft"></rect>
    <rect x="224" y="70" width="40" height="7" rx="3.5" class="soft"></rect>
    <path d="M116 65h88" class="soft" stroke-dasharray="4 5"></path>
    <rect x="136" y="57" width="14" height="16" rx="3" class="signal"></rect>
    <rect x="170" y="57" width="14" height="16" rx="3" class="signal"></rect>
    <path d="M196 59l8 6-8 6M124 59l-8 6 8 6" class="signal"></path>
  </svg>
)}
{kind === "reservas" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="20" y="10" width="190" height="112" rx="10"></rect>
    <path d="M20 34h190" class="soft"></path>
    <rect x="30" y="44" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="64" y="44" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="98" y="44" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="132" y="44" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="166" y="44" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="30" y="70" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="64" y="70" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="98" y="70" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="132" y="70" width="26" height="20" rx="4" class="signal"></rect>
    <rect x="166" y="70" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="30" y="96" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="64" y="96" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="98" y="96" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="132" y="96" width="26" height="20" rx="4" class="soft"></rect>
    <rect x="166" y="96" width="26" height="20" rx="4" class="soft"></rect>
    <path d="M136 80l5 5 9-10" class="signal"></path>
    <circle cx="262" cy="66" r="26"></circle>
    <path d="M262 50v16l10 6" class="soft"></path>
  </svg>
)}
{kind === "datos" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 14v102h280" class="soft"></path>
    <rect x="60" y="76" width="30" height="40" rx="3" class="soft"></rect>
    <rect x="130" y="56" width="30" height="60" rx="3" class="soft"></rect>
    <rect x="200" y="40" width="30" height="76" rx="3" class="soft"></rect>
    <path d="M38 88l60-26 62-4 64-30 52-12" class="signal"></path>
    <circle cx="98" cy="62" r="4" class="signal"></circle>
    <circle cx="160" cy="58" r="4" class="signal"></circle>
    <circle cx="224" cy="28" r="4" class="signal"></circle>
    <circle cx="276" cy="16" r="4" class="signal"></circle>
  </svg>
)}
