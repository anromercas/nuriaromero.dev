---
import "@/styles/template.css";

interface Props {
  animate?: boolean;
}

const { animate = true } = Astro.props;
---

<figure
  class:list={["mock", { animate }]}
  aria-label="Herramienta interna de ejemplo con una lista de pedidos y su estado"
>
  <div class="drawing">
    <svg
      viewBox="0 0 320 220"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="8" y="8" width="304" height="204" rx="10"></rect>
      <path d="M72 8v204" class="soft"></path>
      <path d="M22 30h36M22 52h36M22 74h36M22 96h36" class="soft"></path>
      <path d="M22 52h36" class="signal"></path>
      <text x="84" y="36" class="label">
        Pedidos
      </text>
      <rect x="170" y="23" width="84" height="16" rx="8" class="soft"></rect>
      <rect x="268" y="22" width="30" height="18" rx="6" class="signal"></rect>
      <path d="M283 27v8M279 31h8" class="signal"></path>
      <path d="M72 52h240" class="soft"></path>
      <rect
        x="84"
        y="89"
        width="224"
        height="22"
        rx="6"
        class="signal hl-row"
      ></rect>
      <g>
        <circle cx="94" cy="72" r="5" class="soft"></circle>
        <rect x="108" y="69" width="58" height="6" rx="3" class="soft"></rect>
        <rect x="176" y="69" width="30" height="6" rx="3" class="soft"></rect>
        <rect x="262" y="65" width="34" height="14" rx="7" class="soft"></rect>
      </g>
      <g class="hl">
        <circle cx="94" cy="100" r="5" class="signal"></circle>
        <rect x="108" y="97" width="46" height="6" rx="3" class="soft"></rect>
        <rect x="176" y="97" width="30" height="6" rx="3" class="soft"></rect>
        <rect
          x="262"
          y="93"
          width="34"
          height="14"
          rx="7"
          class="signal"
        ></rect>
      </g>
      <g>
        <circle cx="94" cy="128" r="5" class="soft"></circle>
        <rect x="108" y="125" width="58" height="6" rx="3" class="soft"></rect>
        <rect x="176" y="125" width="30" height="6" rx="3" class="soft"></rect>
        <rect x="262" y="121" width="34" height="14" rx="7" class="soft"></rect>
      </g>
      <g>
        <circle cx="94" cy="156" r="5" class="soft"></circle>
        <rect x="108" y="153" width="46" height="6" rx="3" class="soft"></rect>
        <rect x="176" y="153" width="30" height="6" rx="3" class="soft"></rect>
        <rect x="262" y="149" width="34" height="14" rx="7" class="soft"></rect>
      </g>
      <g>
        <circle cx="94" cy="184" r="5" class="soft"></circle>
        <rect x="108" y="181" width="58" height="6" rx="3" class="soft"></rect>
        <rect x="176" y="181" width="30" height="6" rx="3" class="soft"></rect>
        <rect x="262" y="177" width="34" height="14" rx="7" class="soft"></rect>
      </g>
    </svg>
  </div>
  <figcaption>Ejemplo ilustrativo</figcaption>
</figure>

<style>
  .mock {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1.25rem;
    color: var(--text-muted);
    background: var(--card-surface);
  }

  .drawing {
    padding: 1.25rem;
    border-bottom: 1px solid var(--hairline-quiet);
    background: var(--drawing-surface);
  }

  svg {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
  }

  .signal {
    stroke: var(--sky-signal);
  }

  .soft {
    stroke: var(--drawing-soft);
  }

  .label {
    font-family: inherit;
    font-size: 12px;
    stroke: none;
    fill: var(--text-secondary);
  }

  figcaption {
    padding: 0.55rem 1.25rem 1rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* The completed drawing is the resting state: at scroll 0, at the end of the
     range and wherever scroll timelines are unsupported it is fully visible.
     Motion only where motion is welcome: while scrolling, the highlighted row
     slides a pixel or two and settles back. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .animate .hl,
      .animate .hl-row {
        animation: row-nudge linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 220px;
      }
    }
  }

  @keyframes row-nudge {
    0% {
      transform: none;
    }
    50% {
      transform: translateX(3px);
    }
    100% {
      transform: none;
    }
  }
</style>
