---
// Single-stroke drawings for the "qué puede hacer la IA" bento tiles. Colours come
// from BentoTile (.signal, .soft), so the drawings carry no style of their own.
// Generic shapes only: no brand logos, no figures, no SVG text.
interface Props {
  kind: "chatbot" | "agente" | "respuestas" | "persona" | "resumenes" | "rgpd";
}

const { kind } = Astro.props;
---

{kind === "chatbot" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="12" y="12" width="170" height="106" rx="10"></rect>
    <path d="M12 38h170" class="soft"></path>
    <circle cx="26" cy="25" r="2.5" class="soft"></circle>
    <circle cx="38" cy="25" r="2.5" class="soft"></circle>
    <circle cx="50" cy="25" r="2.5" class="soft"></circle>
    <rect x="66" y="19" width="104" height="12" rx="6" class="soft"></rect>
    <rect x="104" y="66" width="68" height="36" rx="9" class="signal"></rect>
    <rect x="114" y="76" width="44" height="5" rx="2.5" class="signal"></rect>
    <rect x="114" y="87" width="28" height="5" rx="2.5" class="signal"></rect>
    <rect x="216" y="10" width="84" height="110" rx="12"></rect>
    <path d="M246 20h24" class="soft"></path>
    <rect x="226" y="36" width="52" height="22" rx="8" class="soft"></rect>
    <rect x="238" y="68" width="52" height="22" rx="8"></rect>
    <path d="M246 108h24" class="soft"></path>
  </svg>
)}
