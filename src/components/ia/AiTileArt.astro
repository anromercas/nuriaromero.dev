  >
    <rect x="40" y="6" width="80" height="26" rx="8"></rect>
    <rect x="52" y="16" width="50" height="6" rx="3" class="soft"></rect>
    <path d="M80 36v14m-5-5l5 5 5-5" class="signal"></path>
    <rect x="14" y="58" width="132" height="66" rx="8"></rect>
    <rect x="28" y="68" width="24" height="10" rx="3" class="soft"></rect>
    <rect x="68" y="68" width="24" height="10" rx="3" class="soft"></rect>
    <rect x="108" y="68" width="24" height="10" rx="3" class="soft"></rect>
    <rect x="28" y="84" width="24" height="10" rx="3" class="soft"></rect>
    <rect x="68" y="84" width="24" height="10" rx="3" class="signal"></rect>
    <path d="M75 89l4 4 7-7" class="signal"></path>
    <rect x="108" y="84" width="24" height="10" rx="3" class="soft"></rect>
    <rect x="28" y="100" width="24" height="10" rx="3" class="soft"></rect>
    <rect x="68" y="100" width="24" height="10" rx="3" class="soft"></rect>
    <rect x="108" y="100" width="24" height="10" rx="3" class="soft"></rect>
  </svg>
)}
{kind === "respuestas" && (
