---
import "@/styles/template.css";

interface Props {
  animate?: boolean;
}

const { animate = true } = Astro.props;
---

<figure
  class:list={["mock", { animate }]}
  aria-label="Ejemplo de chatbot que responde a un cliente con la información del negocio y pasa la conversación a una persona"
>
  <div class="drawing">
    <svg
      viewBox="0 0 320 220"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="8" y="8" width="304" height="204" rx="12"></rect>
      <circle cx="28" cy="25" r="7" class="soft"></circle>
      <text x="44" y="30" class="label">
        Asistente
      </text>
      <path d="M8 40h304" class="soft"></path>
      <rect x="150" y="48" width="150" height="18" rx="9"></rect>
      <rect x="162" y="54" width="80" height="6" rx="3" class="soft"></rect>
      <rect x="20" y="73" width="190" height="28" rx="10"></rect>
      <rect x="32" y="80" width="150" height="5" rx="2.5" class="soft"></rect>
      <rect x="32" y="90" width="110" height="5" rx="2.5" class="soft"></rect>
      <rect x="190" y="108" width="110" height="18" rx="9"></rect>
      <rect x="202" y="114" width="54" height="6" rx="3" class="soft"></rect>
      <g class="handoff">
        <path
          d="M20 145h120M180 145h120"
          class="soft"
          stroke-dasharray="3 5"
        ></path>
        <circle cx="160" cy="137" r="5" class="signal"></circle>
        <path d="M150 154a10 10 0 0 1 20 0" class="signal"></path>
        <rect
          x="20"
          y="160"
          width="150"
          height="18"
          rx="9"
          class="signal"
        ></rect>
        <rect x="32" y="166" width="84" height="6" rx="3" class="signal"></rect>
      </g>
      <rect x="20" y="188" width="250" height="16" rx="8" class="soft"></rect>
      <path d="M282 196h14m-5-5l5 5-5 5" class="signal"></path>
    </svg>
  </div>
  <figcaption>Ejemplo ilustrativo</figcaption>
</figure>

<style>
  .mock {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1.25rem;
    color: var(--text-muted);
    background: var(--card-surface);
  }

  .drawing {
    padding: 1.25rem;
    border-bottom: 1px solid var(--hairline-quiet);
    background: var(--drawing-surface);
  }

  svg {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin-inline: auto;
  }

  .signal {
    stroke: var(--sky-signal);
  }

  .soft {
    stroke: var(--drawing-soft);
  }

  /* 15 viewBox units render at 11 px or more at a 320 px viewport. */
  .label {
    font-family: inherit;
    font-size: 15px;
    stroke: none;
    fill: var(--text-secondary);
  }

  figcaption {
    padding: 0.55rem 1.25rem 1rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* The completed drawing is the resting state: at scroll 0, at the end of the
     range and wherever scroll timelines are unsupported it is fully visible.
     Motion only where motion is welcome: while scrolling, the handoff group
     rises a pixel or two and settles back. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .animate .handoff {
        animation: handoff-nudge linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 220px;
      }
    }
  }

  @keyframes handoff-nudge {
    0% {
      transform: none;
    }
    50% {
      transform: translateY(-3px);
    }
    100% {
      transform: none;
    }
  }
</style>
