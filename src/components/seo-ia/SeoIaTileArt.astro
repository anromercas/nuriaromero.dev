---
// Single-stroke drawings for the "qué trabajo" bento tiles of /seo-para-ia/. Colours
// come from BentoTile (.signal, .soft), so the drawings carry no style of their own.
// Generic shapes only: no brand logos, no figures, no stars, no SVG text.
interface Props {
  kind:
    | "coherencia"
    | "respuestas"
    | "schema"
    | "rastreadores"
    | "llms"
    | "senales";
}

const { kind } = Astro.props;
---

{kind === "coherencia" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="12" y="14" width="88" height="102" rx="8"></rect>
    <rect x="116" y="14" width="88" height="102" rx="8"></rect>
    <rect x="220" y="14" width="88" height="102" rx="8"></rect>
    <rect x="24" y="50" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="24" y="70" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="24" y="90" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="128" y="50" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="128" y="70" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="128" y="90" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="232" y="50" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="232" y="70" width="64" height="7" rx="3.5" class="soft"></rect>
    <rect x="232" y="90" width="64" height="7" rx="3.5" class="soft"></rect>
    <path d="M12 24h88" class="soft"></path>
    <circle cx="132" cy="32" r="5" class="soft"></circle>
    <path d="M120 40h60" class="soft"></path>
    <circle cx="250" cy="30" r="6" class="soft"></circle>
    <path d="M232 40h40" class="soft"></path>
    <path d="M20 73h280" class="signal"></path>
  </svg>
)}
{kind === "respuestas" && (
  <svg
    viewBox="0 0 160 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="14" y="10" width="132" height="110" rx="8"></rect>
    <rect x="28" y="26" width="104" height="10" rx="5" class="signal"></rect>
    <rect x="28" y="50" width="84" height="7" rx="3.5" class="soft"></rect>
    <rect x="28" y="66" width="96" height="7" rx="3.5" class="soft"></rect>
    <rect x="28" y="82" width="70" height="7" rx="3.5" class="soft"></rect>
    <rect x="28" y="98" width="88" height="7" rx="3.5" class="soft"></rect>
    <path d="M8 25l5 5-5 5" class="signal"></path>
  </svg>
)}
{kind === "schema" && (
  <svg
    viewBox="0 0 160 230"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M36 12q-14 0-14 14v22q0 8-10 8q10 0 10 8v22q0 14 14 14"
      class="soft"
    ></path>
    <path
      d="M124 12q14 0 14 14v22q0 8 10 8q-10 0-10 8v22q0 14-14 14"
      class="soft"
    ></path>
    <rect x="48" y="28" width="22" height="6" rx="3" class="soft"></rect>
    <rect x="76" y="28" width="34" height="6" rx="3" class="signal"></rect>
    <rect x="48" y="52" width="22" height="6" rx="3" class="soft"></rect>
    <rect x="76" y="52" width="34" height="6" rx="3" class="signal"></rect>
    <rect x="48" y="76" width="22" height="6" rx="3" class="soft"></rect>
    <rect x="76" y="76" width="34" height="6" rx="3" class="signal"></rect>
    <path d="M80 114v22m-5-5l5 5 5-5" class="signal"></path>
    <circle cx="80" cy="160" r="10" class="signal"></circle>
    <circle cx="40" cy="204" r="9"></circle>
    <circle cx="120" cy="204" r="9"></circle>
    <path d="M74 169l-27 28M86 169l27 28" class="soft"></path>
  </svg>
)}
{kind === "rastreadores" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="14" y="18" width="70" height="94" rx="8"></rect>
    <rect x="26" y="32" width="46" height="6" rx="3" class="soft"></rect>
    <rect x="26" y="50" width="46" height="6" rx="3" class="soft"></rect>
    <rect x="26" y="68" width="46" height="6" rx="3" class="soft"></rect>
    <rect x="26" y="86" width="46" height="6" rx="3" class="soft"></rect>
    <path d="M120 112V40M180 112V40"></path>
    <path d="M120 44l-26 10v56" class="soft"></path>
    <path d="M84 76h50" class="signal"></path>
    <path d="M134 76h60" class="signal"></path>
    <path d="M188 70l6 6-6 6" class="signal"></path>
    <circle cx="108" cy="76" r="3" class="signal"></circle>
    <circle cx="150" cy="76" r="3" class="signal"></circle>
    <circle cx="172" cy="76" r="3" class="signal"></circle>
    <rect x="214" y="18" width="92" height="94" rx="8"></rect>
    <path d="M214 36h92" class="soft"></path>
    <rect x="226" y="50" width="60" height="7" rx="3.5" class="soft"></rect>
    <rect x="226" y="68" width="44" height="7" rx="3.5" class="soft"></rect>
    <rect x="226" y="86" width="52" height="7" rx="3.5" class="soft"></rect>
  </svg>
)}
{kind === "llms" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="14" y="14" width="150" height="102" rx="8"></rect>
    <rect x="28" y="26" width="8" height="8" rx="2" class="soft"></rect>
    <rect x="46" y="27" width="92" height="6" rx="3" class="soft"></rect>
    <rect x="28" y="48" width="8" height="8" rx="2" class="soft"></rect>
    <rect x="46" y="49" width="100" height="6" rx="3" class="signal"></rect>
    <rect x="28" y="70" width="8" height="8" rx="2" class="soft"></rect>
    <rect x="46" y="71" width="92" height="6" rx="3" class="soft"></rect>
    <rect x="28" y="92" width="8" height="8" rx="2" class="soft"></rect>
    <rect x="46" y="93" width="92" height="6" rx="3" class="soft"></rect>
    <path d="M146 56h40m-5-5l5 5-5 5" class="signal"></path>
    <path d="M232 22h60q6 0 6 6v66" class="soft"></path>
    <path d="M220 32h60q6 0 6 6v66" class="soft"></path>
    <rect x="208" y="42" width="66" height="72" rx="6"></rect>
    <rect x="220" y="56" width="42" height="6" rx="3" class="soft"></rect>
    <rect x="220" y="72" width="30" height="6" rx="3" class="soft"></rect>
  </svg>
)}
{kind === "senales" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="160" cy="65" r="20"></circle>
    <path d="M142 55l-56-29" class="signal"></path>
    <path d="M180 65h56" class="signal"></path>
    <path d="M142 77l-38 26" class="signal"></path>
    <path d="M60 22a12 12 0 0 1 24 0c0 10-12 22-12 22S60 32 60 22z"></path>
    <circle cx="72" cy="22" r="4" class="soft"></circle>
    <rect x="236" y="48" width="70" height="34" rx="8"></rect>
    <circle cx="252" cy="65" r="6" class="soft"></circle>
    <rect x="264" y="58" width="32" height="6" rx="3" class="soft"></rect>
    <rect x="264" y="70" width="22" height="6" rx="3" class="soft"></rect>
    <rect x="36" y="92" width="68" height="24" rx="10"></rect>
    <rect x="48" y="100" width="44" height="5" rx="2.5" class="soft"></rect>
    <rect x="48" y="108" width="28" height="5" rx="2.5" class="soft"></rect>
  </svg>
)}
