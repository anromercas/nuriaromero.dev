---
interface Props {
  faqs: { q: string; a: string }[]
}

const { faqs } = Astro.props
---

<div class="space-y-3">
  {
    faqs.map((faq) => (
      <details class="group rounded-xl border border-gray-300 bg-gray-100/50 p-5 dark:border-gray-700 dark:bg-gray-800/50">
        <summary class="cursor-pointer list-none font-semibold text-gray-800 dark:text-gray-100 marker:content-none [&::-webkit-details-marker]:hidden">
          <span class="mr-2 inline-block transition group-open:rotate-90" aria-hidden="true">
            ›
          </span>
          {faq.q}
        </summary>
        <p class="mt-3 text-gray-700 dark:text-gray-400">{faq.a}</p>
      </details>
    ))
  }
</div>
