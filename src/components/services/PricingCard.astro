---
import LinkButton from "@/components/LinkButton.astro"
import Link from "@/components/icons/Link.astro"

interface Tier {
  name: string
  from: string
  includes: string[]
  note?: string
  ctaLabel?: string
  recommended?: boolean
}

interface Initial {
  from: string
  includes?: string[]
  note?: string
  ctaLabel?: string
}

interface Props {
  from?: string
  includes?: string[]
  note?: string
  initial?: Initial
  tiers?: Tier[]
}

const { from, includes, note, initial, tiers } = Astro.props
---

{
  tiers ? (
    <div>
      {initial && (
        <div class="mb-8 rounded-xl border border-gray-300 bg-gray-100/50 p-6 dark:border-gray-700 dark:bg-gray-800/50 md:max-w-lg">
          <p class="text-gray-700 dark:text-gray-400">Proyecto inicial</p>
          <p class="mb-4 text-3xl font-bold text-gray-800 dark:text-white">
            {initial.from}
          </p>
          {initial.includes && (
            <ul class="mb-4 space-y-2 text-gray-700 dark:text-gray-400">
              {initial.includes.map((item) => (
                <li class="flex gap-x-2">
                  <span
                    class="text-green-600 dark:text-green-400"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          )}
          {initial.note && (
            <p class="mb-4 text-sm text-gray-600 dark:text-gray-500">
              {initial.note}
            </p>
          )}
          <LinkButton href="/contacto">
            <Link class="size-4" />
            {initial.ctaLabel ?? "Pedir presupuesto exacto"}
          </LinkButton>
        </div>
      )}
      {note && (
        <p class="mb-6 text-gray-700 dark:text-gray-400">{note}</p>
      )}
      <div class="grid gap-6 sm:grid-cols-2">
      {tiers.map((tier) => (
        <div
          class:list={[
            "rounded-xl border p-6",
            tier.recommended
              ? "border-2 border-yellow-500 bg-gray-100/50 dark:border-yellow-200 dark:bg-gray-800/50"
              : "border-gray-300 bg-gray-100/50 dark:border-gray-700 dark:bg-gray-800/50",
          ]}
        >
          {tier.recommended && (
            <p class="mb-2 inline-block rounded-full bg-yellow-500/90 px-3 py-0.5 text-xs font-semibold text-gray-900 dark:bg-yellow-200">
              Recomendado
            </p>
          )}
          <p class="text-gray-700 dark:text-gray-400">{tier.name}</p>
          <p class="mb-4 text-3xl font-bold text-gray-800 dark:text-white">
            Desde {tier.from}
          </p>
          <ul class="mb-6 space-y-2 text-gray-700 dark:text-gray-400">
            {tier.includes.map((item) => (
              <li class="flex gap-x-2">
                <span
                  class="text-green-600 dark:text-green-400"
                  aria-hidden="true"
                >
                  ✓
                </span>
                {item}
              </li>
            ))}
          </ul>
          {tier.note && (
            <p class="mb-6 text-sm text-gray-600 dark:text-gray-500">
              {tier.note}
            </p>
          )}
          <LinkButton href="/contacto">
            <Link class="size-4" />
            {tier.ctaLabel ?? "Pedir presupuesto exacto"}
          </LinkButton>
        </div>
      ))}
      </div>
    </div>
  ) : (
    <div class="rounded-xl border border-gray-300 bg-gray-100/50 p-6 dark:border-gray-700 dark:bg-gray-800/50 md:max-w-lg">
      <p class="text-gray-700 dark:text-gray-400">Desde</p>
      <p class="mb-4 text-4xl font-bold text-gray-800 dark:text-white">
        {from}
      </p>
      <ul class="mb-6 space-y-2 text-gray-700 dark:text-gray-400">
        {includes?.map((item) => (
          <li class="flex gap-x-2">
            <span
              class="text-green-600 dark:text-green-400"
              aria-hidden="true"
            >
              ✓
            </span>
            {item}
          </li>
        ))}
      </ul>
      {note && (
        <p class="mb-6 text-sm text-gray-600 dark:text-gray-500">{note}</p>
      )}
      <LinkButton href="/contacto">
        <Link class="size-4" />
        Pedir presupuesto exacto
      </LinkButton>
    </div>
  )
}
