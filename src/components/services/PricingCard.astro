---
import LinkButton from "@/components/LinkButton.astro"
import Link from "@/components/icons/Link.astro"

interface Props {
  from: string
  includes: string[]
  note?: string
}

const { from, includes, note } = Astro.props
---

<div
  class="rounded-xl border border-gray-300 bg-gray-100/50 p-6 dark:border-gray-700 dark:bg-gray-800/50 md:max-w-lg"
>
  <p class="text-gray-700 dark:text-gray-400">Desde</p>
  <p class="mb-4 text-4xl font-bold text-gray-800 dark:text-white">
    {from}
  </p>
  <ul class="mb-6 space-y-2 text-gray-700 dark:text-gray-400">
    {
      includes.map((item) => (
        <li class="flex gap-x-2">
          <span class="text-green-600 dark:text-green-400" aria-hidden="true">
            ✓
          </span>
          {item}
        </li>
      ))
    }
  </ul>
  {note && <p class="mb-6 text-sm text-gray-600 dark:text-gray-500">{note}</p>}
  <LinkButton href="/contacto">
    <Link class="size-4" />
    Pedir presupuesto exacto
  </LinkButton>
</div>
