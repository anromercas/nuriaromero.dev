---
interface Props {
  steps: { title: string; text: string }[]
}

const { steps } = Astro.props
---

<ol class="space-y-6">
  {
    steps.map((step, i) => (
      <li class="flex gap-x-4">
        <span
          class="flex size-9 shrink-0 items-center justify-center rounded-full bg-yellow-500/90 font-bold text-black dark:bg-yellow-200"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div>
          <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">
            {step.title}
          </h3>
          <p class="text-gray-700 dark:text-gray-400">{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>
