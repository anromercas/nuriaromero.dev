---
interface Props {
  benefits: { title: string; text: string }[]
}

const { benefits } = Astro.props
---

<ul class="grid gap-6 sm:grid-cols-2">
  {
    benefits.map((benefit) => (
      <li class="rounded-xl border border-gray-300 bg-gray-100/50 p-5 dark:border-gray-700 dark:bg-gray-800/50">
        <h3 class="mb-2 text-lg font-semibold text-gray-800 dark:text-gray-100">
          {benefit.title}
        </h3>
        <p class="text-gray-700 dark:text-gray-400">{benefit.text}</p>
      </li>
    ))
  }
</ul>
