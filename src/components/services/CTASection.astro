---
import BookingButton from "@/components/BookingButton.astro"

interface Props {
  title?: string
  text?: string
}

const {
  title = "¿Hablamos de tu proyecto?",
  text = "Cuéntame qué necesita tu negocio y te respondo con una propuesta clara, sin compromiso y sin tecnicismos.",
} = Astro.props
---

<div
  class="rounded-xl border border-gray-300 bg-gray-100/50 p-8 text-center dark:border-gray-700 dark:bg-gray-800/50"
>
  <h2 class="mb-3 text-2xl font-semibold text-black/80 dark:text-white">
    {title}
  </h2>
  <p class="mx-auto mb-6 max-w-xl text-gray-300">{text}</p>
  <nav class="flex flex-wrap justify-center gap-4">
    <BookingButton />
  </nav>
  <p class="mt-4 text-sm text-gray-600 dark:text-gray-500">
    30 minutos · Sin compromiso · Directamente conmigo
  </p>
</div>
