---
import BookingButton from "@/components/BookingButton.astro"

interface Props {
  h1: string
  subtitle: string
  primaryCtaLabel?: string
  secondaryCta?: {
    label: string
    href: string
  }
}

const { h1, subtitle, primaryCtaLabel, secondaryCta } = Astro.props
---

<div class="py-10 md:py-16">
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white mb-6"
  >
    {h1}
  </h1>
  <p class="text-xl text-gray-800 dark:text-gray-300 max-w-2xl">
    {subtitle}
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <BookingButton label={primaryCtaLabel} />
    {
      secondaryCta && (
        <a
          href={secondaryCta.href}
          class="inline-flex items-center justify-center gap-2 px-4 py-1 text-gray-700 transition rounded-full text-md hover:text-blue-500 dark:text-gray-300 dark:hover:text-blue-500 max-w-fit underline underline-offset-4"
        >
          {secondaryCta.label}
        </a>
      )
    }
  </nav>
</div>
