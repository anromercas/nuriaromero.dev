---
import type { InternalLink } from "@/data/internal-links"

interface Props {
  links: InternalLink[]
}

const { links } = Astro.props
const contextualLinks = links.filter((link) => link.kind === "contextual")
const conversionLinks = links.filter((link) => link.kind === "conversion")
---

{links.length > 0 && (
  <aside class="rounded-xl border border-gray-200 bg-gray-50/70 p-6 dark:border-gray-700 dark:bg-gray-800/40" aria-labelledby="related-links-title">
    <h2 id="related-links-title" class="mb-4 text-lg font-semibold text-gray-800 dark:text-gray-100">
      Contenido relacionado
    </h2>
    <ul class="flex flex-wrap gap-x-5 gap-y-2 text-gray-700 dark:text-gray-300">
      {contextualLinks.map((link) => (
        <li><a class="text-blue-600 underline-offset-4 hover:underline dark:text-blue-400" href={link.path}>{link.anchor}</a></li>
      ))}
    </ul>
    {conversionLinks.length > 0 && (
      <p class="mt-5 text-gray-700 dark:text-gray-300">
        {conversionLinks.map((link, index) => (
          <Fragment>
            {index > 0 ? " · " : ""}
            <a class="font-medium text-blue-600 underline-offset-4 hover:underline dark:text-blue-400" href={link.path}>{link.anchor}</a>
          </Fragment>
        ))}
      </p>
    )}
  </aside>
)}
