---
import WhatsAppIcon from "@/components/icons/WhatsApp.astro"
import { whatsappUrl } from "@/data/site"
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbeme por WhatsApp"
  title="Escríbeme por WhatsApp"
  data-seo12-whatsapp
  id="whatsapp-floating-button"
  class="fixed bottom-4 right-4 z-40 flex size-12 items-center justify-center rounded-full bg-green-600 text-white shadow-lg transition hover:scale-110 hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700 sm:bottom-5 sm:right-5 sm:size-14"
>
  <WhatsAppIcon class="size-6 sm:size-8" />
</a>

<style>
  /*
   * SEO-17: en mobile, el botón flotante se solapaba geométricamente con el
   * CTA "Ver qué puedo hacer por tu negocio" del hero de la home (que ya
   * incluye su propio CTA de WhatsApp inline, por lo que el flotante es
   * redundante ahí). Se saca del flujo/layout con display:none mientras ese
   * CTA está en viewport, para eliminar también el solape geométrico
   * (no solo el visual), sin quitarlo del resto de secciones del sitio.
   */
  #whatsapp-floating-button.is-hero-cta-visible {
    display: none;
  }
</style>

<script>
  import "../scripts/whatsapp-button.js"
</script>
