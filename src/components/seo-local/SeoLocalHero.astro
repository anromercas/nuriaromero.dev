---
import BookingButton from "@/components/BookingButton.astro";
import SectionHeading from "@/components/seo-local/SectionHeading.astro";
import "@/styles/template.css";
import type { AccentTitle, TextLink } from "./types";

interface Props {
  keyword: string;
  title: AccentTitle;
  subtitle: string;
  primaryCtaLabel?: string;
  secondaryLink?: TextLink;
  actionsAttrs?: Record<string, string>;
}

const {
  keyword,
  title,
  subtitle,
  primaryCtaLabel,
  secondaryLink,
  actionsAttrs,
} = Astro.props;
const hasVisual = Astro.slots.has("visual");
---

<div class:list={["hero", { "hero-solo": !hasVisual }]}>
  <div class="hero-copy">
    <SectionHeading
      level="h1"
      keyword={keyword}
      title={title}
      class="hero-display"
    />
    <p class="hero-subtitle">{subtitle}</p>
    <div class="hero-actions" data-consent-avoid {...actionsAttrs}>
      <BookingButton label={primaryCtaLabel} />
      {secondaryLink && <a class="hero-link" href={secondaryLink.href}>{secondaryLink.label}</a>}
    </div>
  </div>
  {hasVisual && (
    <div class="hero-visual">
      <slot name="visual" />
    </div>
  )}
</div>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: 2.5rem 1.5rem;
    align-items: center;
  }

  .hero-copy :global(.hero-display) {
    max-width: 16ch;
    margin: 0 0 1.5rem;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    line-height: 1.04;
  }

  .hero-subtitle {
    max-width: 52ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }

  .hero-link {
    color: var(--text-body);
    text-decoration: underline;
    text-decoration-color: rgb(var(--sky-signal-rgb) / 0.7);
    text-underline-offset: 0.3em;
    border-radius: 0.25rem;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-link:hover {
    color: var(--sky-accent);
  }

  .hero-link:focus-visible {
    outline: 2px solid var(--sky-signal);
    outline-offset: 4px;
  }

  .hero-visual {
    position: relative;
    isolation: isolate;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    inset: -25% -1rem;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      rgb(var(--sky-signal-rgb) / 0.18),
      transparent
    );
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2rem;
    }

    .hero.hero-solo {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
