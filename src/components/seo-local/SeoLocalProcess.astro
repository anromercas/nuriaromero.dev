---
import { Image } from "astro:assets"
import profileHome from "@/assets/perfil-home.webp"
import SectionHeading from "@/components/seo-local/SectionHeading.astro"
import "@/styles/template.css"
import type { AccentTitle, Step } from "./types"

interface Props {
  headingId?: string
  id?: string
  keyword: string
  title: AccentTitle
  steps: Step[]
  portrait?: boolean
  portraitAlt?: string
  answer?: string
}

const {
  headingId = "proceso-title",
  id,
  keyword,
  title,
  steps,
  portrait = true,
  portraitAlt = "Nuria Romero, desarrolladora web freelance en Sevilla",
  answer,
} = Astro.props
---

<section id={id} class:list={["process", { "scroll-m-20": id }]} aria-labelledby={headingId}>
  <SectionHeading id={headingId} keyword={keyword} title={title} class="process-display" answer={answer} />
  {Astro.slots.has("byline") && <p class="byline"><slot name="byline" /></p>}

  <div class:list={["process-grid", { "no-portrait": !portrait }]}>
    {
      portrait && (
        <figure class="person">
          <Image
            src={profileHome}
            alt={portraitAlt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 320px, 70vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>{portraitAlt}</figcaption>
        </figure>
      )
    }

    <div class="steps">
      <ol class="timeline">
        {
          steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>

      <slot name="aside" />
    </div>
  </div>
</section>

<style>
  .process {
    color: var(--text-body);
  }

  .process :global(.process-display) {
    max-width: 20ch;
    margin: 0 0 2.25rem;
  }

  .process :global(.process-display:has(+ .tpl-answer)) {
    margin-bottom: 1rem;
  }

  .process :global(.tpl-answer) {
    margin-bottom: 2.25rem;
  }

  .byline {
    max-width: 40rem;
    margin: -1.25rem 0 2.25rem;
    color: var(--text-secondary);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .byline :global(a) {
    color: var(--sky-accent);
    text-underline-offset: 0.25em;
  }

  .byline :global(a:hover) {
    color: var(--text-strong);
  }

  .process-grid {
    display: grid;
    gap: 2.5rem;
  }

  .person {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--hairline);
    border-radius: 1.25rem;
    background: var(--card-surface);
  }

  .person :global(img) {
    display: block;
    width: 100%;
    max-width: 20rem;
    height: auto;
    margin-inline: auto;
    border-radius: 0.9rem;
  }

  figcaption {
    margin-top: 0.9rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .steps {
    display: grid;
    gap: 2.5rem;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.3rem;
    width: 1px;
    background: rgb(var(--sky-signal-rgb) / 0.55);
  }

  .timeline li {
    position: relative;
    padding-bottom: 1.75rem;
  }

  .timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline li::before {
    content: "";
    position: absolute;
    top: 0.45rem;
    left: -1.75rem;
    width: 0.65rem;
    height: 0.65rem;
    border: 1.5px solid var(--sky-signal);
    border-radius: 50%;
    background: var(--site-ground);
  }

  h3 {
    margin: 0 0 0.35rem;
    color: var(--text-strong);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .timeline p {
    max-width: 65ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.975rem;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: 3rem;
      align-items: stretch;
    }

    .process-grid.no-portrait {
      grid-template-columns: minmax(0, 1fr);
    }

    .person :global(img) {
      flex: 1 1 0;
      min-height: 16rem;
      max-width: none;
      height: auto;
      object-fit: cover;
      object-position: top;
    }
  }
</style>
