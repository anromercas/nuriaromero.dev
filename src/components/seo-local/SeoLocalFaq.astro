---
import BookingButton from "@/components/BookingButton.astro"
import SectionHeading from "@/components/seo-local/SectionHeading.astro"
import "@/styles/template.css"
import type { AccentTitle, FaqItem } from "./types"

interface Props {
  headingId: string
  keyword: string
  title: AccentTitle
  lede: string
  faqs: FaqItem[]
  ctaLabel?: string
}

const { headingId, keyword, title, lede, faqs, ctaLabel = "Reservar una llamada" } = Astro.props

const splitAnswer = (answer: string) => {
  const match = answer.match(/^[\s\S]*?[.!?](?=\s|$)/)
  if (!match) return { lead: answer, context: [] as string[] }
  const rest = answer.slice(match[0].length).trim()
  return {
    lead: match[0],
    context: rest ? rest.split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean) : [],
  }
}
---

<section class="faq" aria-labelledby={headingId}>
  <div class="faq-intro">
    <SectionHeading id={headingId} keyword={keyword} title={title} class="faq-display" />
    <p class="lede">{lede}</p>
    <BookingButton label={ctaLabel} />
  </div>

  <div class="faq-list">
    {
      faqs.map((faq) => (
        <details>
          <summary>
            <span class="question">{faq.q}</span>
            <svg class="indicator" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M5 12h14"></path>
              <path class="vertical" d="M12 5v14"></path>
            </svg>
          </summary>
          <div class="answer">
            <p><strong>{splitAnswer(faq.a).lead}</strong></p>
            {splitAnswer(faq.a).context.map((paragraph) => <p>{paragraph}</p>)}
            {
              faq.links && faq.links.length > 0 && (
                <p class="answer-links">
                  {faq.links.map((link, index) => (
                    <Fragment>
                      {index > 0 && <span aria-hidden="true"> · </span>}
                      <a class="tpl-link" href={link.href}>{link.label}</a>
                    </Fragment>
                  ))}
                </p>
              )
            }
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 2rem;
    color: var(--text-body);
  }

  .faq-intro :global(.faq-display) {
    max-width: 14ch;
    margin: 0 0 1rem;
  }

  .faq-intro .lede {
    max-width: 32ch;
    margin: 0 0 1.5rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .faq-list {
    border-top: 1px solid var(--hairline);
  }

  details {
    border-bottom: 1px solid var(--hairline);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0.25rem;
    color: var(--text-strong);
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
    border-radius: 0.5rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--sky-signal);
    outline-offset: 2px;
  }

  .indicator {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--sky-signal);
  }

  details[open] .vertical {
    display: none;
  }

  .answer {
    max-width: 65ch;
    padding: 0 0.25rem 1.25rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .answer p {
    margin: 0 0 0.75rem;
  }

  .answer .answer-links {
    max-width: 65ch;
  }

  .answer strong {
    color: var(--text-strong);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 4rem;
      align-items: start;
    }

    .faq-intro {
      position: sticky;
      top: 6rem;
    }
  }
</style>
