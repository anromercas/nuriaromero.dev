---
import { SITE } from "@/data/site"
---

<section class="nap" aria-labelledby="nap-title">
  <h2 id="nap-title" class="kw">SEO local desde La Rinconada, Sevilla</h2>
  <address>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 21c-4-4.5-6.5-7.6-6.5-11a6.5 6.5 0 0 1 13 0c0 3.4-2.5 6.5-6.5 11z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </svg>
    <div class="lines">
      <p class="name">{SITE.name}</p>
      <p>{SITE.address.full}</p>
      <p><a href={`tel:+${SITE.whatsapp}`}>{SITE.phone}</a></p>
    </div>
  </address>
  <a class="maps" href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer">Ver en Google Maps</a>
</section>

<style>
  .nap {
    display: grid;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(51 65 85);
    color: rgb(226 232 240);
  }

  .kw {
    margin: 0;
    color: rgb(203 213 225);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  address {
    display: flex;
    gap: 0.9rem;
    font-style: normal;
  }

  address svg {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.15rem;
    color: rgb(56 189 248);
  }

  .lines p {
    margin: 0;
    line-height: 1.6;
  }

  .name {
    color: white;
    font-weight: 600;
  }

  a {
    color: rgb(125 211 252);
    text-underline-offset: 0.25em;
    border-radius: 0.25rem;
  }

  a:focus-visible {
    outline: 2px solid rgb(56 189 248);
    outline-offset: 3px;
  }

  .maps {
    justify-self: start;
  }
</style>
