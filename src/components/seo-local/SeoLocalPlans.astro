---
import BookingButton from "@/components/BookingButton.astro"
import SectionHeading from "@/components/seo-local/SectionHeading.astro"
import "@/styles/template.css"
import type { AccentTitle, Tier } from "./types"

interface Props {
  id?: string
  headingId: string
  keyword: string
  title: AccentTitle
  tiers: Tier[]
  note?: string
  answer?: string
}

const { id = "precios", headingId, keyword, title, tiers, note, answer } = Astro.props
---

<section id={id} class="plans scroll-m-20" aria-labelledby={headingId}>
  <SectionHeading id={headingId} keyword={keyword} title={title} class="plans-display" answer={answer} />
  {Astro.slots.has("lede") && <p class="plans-lede"><slot name="lede" /></p>}
  {note && <p class="plans-note">{note}</p>}

  <div class="plan-list">
    {
      tiers.map((tier) => (
        <article class:list={["plan", { recommended: tier.recommended }]}>
          <div class="plan-head">
            <h3>{tier.name}</h3>
            {tier.recommended && <span class="badge">Recomendado</span>}
          </div>
          <p class="price">{tier.from}</p>
          <ul>
            {tier.includes.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          {tier.note && <p class="plan-note">{tier.note}</p>}
          <div class="plan-cta"><BookingButton label={tier.ctaLabel} /></div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .plans {
    color: var(--text-body);
  }

  .plans :global(.plans-display) {
    max-width: 20ch;
    margin: 0 0 1rem;
  }

  .plans :global(.tpl-answer) {
    margin-bottom: 2rem;
  }

  .plans :global(.tpl-answer:has(+ .plans-lede, + .plans-note)) {
    margin-bottom: 0.75rem;
  }

  .plans-lede {
    max-width: 52ch;
    margin: 0 0 0.75rem;
    color: var(--text-body);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .plans-lede :global(strong) {
    color: var(--text-strong);
    font-weight: 650;
    white-space: nowrap;
  }

  .plans-note {
    max-width: 65ch;
    margin: 0 0 2rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .plan-list {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }

  .plan {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--hairline);
    border-radius: 1.25rem;
    background: var(--card-surface);
  }

  .plan-cta {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .plan.recommended {
    border-color: var(--yellow-recommend);
    background: var(--card-surface-recommended);
  }

  .plan-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  h3 {
    margin: 0;
    color: var(--text-strong);
    font-size: 1.25rem;
    font-weight: 650;
  }

  .badge {
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background: var(--yellow-recommend);
    color: var(--yellow-ink);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .price {
    margin: 0;
    color: var(--text-strong);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 1rem 0 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
    width: 100%;
  }

  li {
    display: flex;
    gap: 0.6rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  li svg {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    color: var(--sky-signal);
  }

  .recommended li svg {
    color: var(--yellow-recommend);
  }

  .plan-note {
    max-width: 65ch;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .plan-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .plan.recommended {
      /* Deliberate lift: grows the card upward so both buttons keep the same baseline. */
      margin-top: -0.75rem;
    }
  }

  /* One plan: a single left-aligned card at every width (NRD-168, 166, 167). */
  .plan-list:has(> .plan:only-child) {
    grid-template-columns: minmax(0, 1fr);
    max-width: 36rem;
    margin-inline: 0;
  }

  /* Three plans: one column up to 1023px (no 2 + 1 grid), three from 1024px. */
  @media (min-width: 768px) {
    .plan-list:has(> .plan:nth-child(3):last-child) {
      grid-template-columns: minmax(0, 1fr);
      max-width: 36rem;
      margin-inline: 0;
    }
  }

  @media (min-width: 1024px) {
    .plan-list:has(> .plan:nth-child(3):last-child) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
    }
  }
</style>
