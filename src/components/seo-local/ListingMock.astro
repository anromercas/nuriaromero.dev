---
interface Props {
  animate?: boolean
}

const { animate = true } = Astro.props
const checks = [
  "Horarios actualizados",
  "Servicios claros",
  "Fotos nuevas",
  "Reseñas respondidas",
]
const services = ["Servicio uno", "Servicio dos", "Servicio tres"]
const starPoints = "12 3 14.6 9 21 9.6 16.2 13.9 17.6 20.2 12 17 6.4 20.2 7.8 13.9 3 9.6 9.4 9"
---

<figure class:list={["listing", { animate }]} aria-label="Ficha de Google de ejemplo">
  <svg class="storefront" viewBox="0 0 320 96" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M24 88h272"></path>
    <path d="M40 88V36h240v52"></path>
    <path d="M32 36l12-20h232l12 20z"></path>
    <path d="M32 36q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0q9 12 18 0"></path>
    <rect x="64" y="52" width="72" height="36" rx="3"></rect>
    <rect x="184" y="52" width="72" height="36" rx="3"></rect>
    <path d="M140 88V56h36v32"></path>
    <path d="M160 56v32"></path>
  </svg>

  <div class="body">
    <p class="name">Tu negocio</p>
    <p class="category">Categoría principal · Sevilla</p>

    <div class="rating-row" aria-hidden="true">
      <div class="stars">
        {Array.from({ length: 5 }).map((_, i) => (
          <svg style={`--s:${i}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" focusable="false"><polygon points={starPoints}></polygon></svg>
        ))}
      </div>
      <span>Reseñas de clientes</span>
    </div>

    <div class="row hours">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>
      <span>Horario de apertura</span>
    </div>

    <ul class="chips" aria-label="Servicios de ejemplo">
      {services.map((s) => <li>{s}</li>)}
    </ul>

    <div class="photos" aria-hidden="true">
      {[0, 1, 2].map((i) => (
        <svg style={`--p:${i}`} viewBox="0 0 64 44" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <rect x="1" y="1" width="62" height="42" rx="5"></rect>
          <g class="scene">
            <path d="M2 43V30c10-8 18-8 26 0 8-10 18-12 34-2v15z" class="hill"></path>
            <circle cx={22 + i * 14} cy="14" r="5" class="sun"></circle>
          </g>
        </svg>
      ))}
    </div>

    <ul class="checks">
      {checks.map((label, i) => (
        <li style={`--i:${i}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.7 2.7L16 9.8"></path></svg>
          {label}
        </li>
      ))}
    </ul>
  </div>
  <figcaption>Ejemplo ilustrativo</figcaption>
</figure>

<style>
  .listing {
    margin: 0;
    overflow: hidden;
    border: 1px solid rgb(51 65 85);
    border-radius: 1.25rem;
    color: rgb(226 232 240);
    background: rgb(8 15 32);
  }

  .storefront {
    display: block;
    width: 100%;
    height: auto;
    padding: 1rem 1.25rem 0;
    color: rgb(125 211 252);
    border-bottom: 1px solid rgb(30 41 59);
    background: rgb(15 23 42);
  }

  .body {
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .name {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 650;
    color: white;
    line-height: 1.2;
  }

  .category {
    margin: -0.55rem 0 0;
    color: rgb(148 163 184);
    font-size: 0.875rem;
  }

  .stars {
    display: flex;
    gap: 0.2rem;
    color: rgb(125 211 252);
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgb(203 213 225);
    font-size: 0.85rem;
  }

  .stars svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .stars polygon {
    fill: currentColor;
  }

  .scene .hill {
    fill: rgb(56 189 248 / 0.28);
    stroke: rgb(56 189 248);
  }

  .scene .sun {
    fill: rgb(125 211 252);
    stroke: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgb(203 213 225);
    font-size: 0.9rem;
  }

  .row svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: rgb(125 211 252);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.2rem 0.7rem;
    border: 1px solid rgb(51 65 85);
    border-radius: 9999px;
    color: rgb(203 213 225);
    font-size: 0.8rem;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    color: rgb(71 85 105);
  }

  .photos svg {
    width: 100%;
    height: auto;
  }

  .checks {
    display: grid;
    gap: 0.45rem;
    margin: 0.25rem 0 0;
    padding: 0.9rem 0 0;
    list-style: none;
    border-top: 1px solid rgb(30 41 59);
  }

  .checks li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: white;
    font-size: 0.9rem;
  }

  .checks svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: rgb(56 189 248);
  }

  figcaption {
    padding: 0.55rem 1.25rem;
    border-top: 1px solid rgb(30 41 59);
    color: rgb(148 163 184);
    font-size: 0.78rem;
  }

  /* Completed state is the default. The listing only "fills in" where a scroll
     timeline exists and motion is welcome; elsewhere it stays complete. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .animate .stars polygon {
        animation: star-fill linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(var(--s) * 30px) calc(var(--s) * 30px + 90px);
      }

      .animate .scene {
        animation: scene-in linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(var(--p) * 40px + 60px) calc(var(--p) * 40px + 200px);
      }

      .animate .rating-row span,
      .animate .checks li {
        animation: check-in linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(var(--i, 2) * 50px + 80px) calc(var(--i, 2) * 50px + 220px);
      }

      .animate .checks svg path {
        stroke-dasharray: 14;
        animation: check-draw linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(var(--i, 0) * 50px + 120px) calc(var(--i, 0) * 50px + 260px);
      }
    }

    @supports not (animation-timeline: scroll()) {
      .animate .checks li {
        animation: check-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: calc(0.35s + var(--i) * 0.28s);
      }
    }
  }

  @keyframes star-fill {
    from {
      fill: transparent;
    }
    to {
      fill: currentColor;
    }
  }

  @keyframes scene-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes check-in {
    from {
      opacity: 0.35;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes check-draw {
    from {
      stroke-dashoffset: 14;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
