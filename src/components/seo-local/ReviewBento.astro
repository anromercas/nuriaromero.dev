---
import SectionHeading from "@/components/seo-local/SectionHeading.astro"
import "@/styles/template.css"
import type { AccentTitle } from "./types"

interface Props {
  headingId?: string
  id?: string
  keyword: string
  title: AccentTitle
  caption?: string
  answer?: string
}

const { headingId = "revision-title", id, keyword, title, caption = "Ejemplo ilustrativo", answer } = Astro.props
---

<section id={id} class:list={["bento-wrap", { "scroll-m-20": id }]} aria-labelledby={headingId}>
  <SectionHeading id={headingId} keyword={keyword} title={title} class="bento-display" answer={answer} />

  <div class="bento">
    <slot />
  </div>
  <p class="bento-caption">{caption}</p>
</section>

<style>
  .bento-wrap {
    color: var(--text-body);
  }

  .bento-wrap :global(.bento-display) {
    max-width: 20ch;
    margin: 0 0 1.75rem;
  }

  .bento-wrap :global(.bento-display:has(+ .tpl-answer)) {
    margin-bottom: 1rem;
  }

  .bento-wrap :global(.tpl-answer) {
    margin-bottom: 1.75rem;
  }

  .bento-caption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .bento-caption::before {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }

  .bento {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        "a a a a b b"
        "c c d d d d"
        "c c e e e e"
        "f f f f f f";
    }
  }
</style>
