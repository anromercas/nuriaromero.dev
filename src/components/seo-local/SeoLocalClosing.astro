---
import BookingButton from "@/components/BookingButton.astro";
import SectionHeading from "@/components/seo-local/SectionHeading.astro";
import "@/styles/template.css";
import type { AccentTitle } from "./types";

interface Props {
  headingId: string;
  keyword: string;
  title: AccentTitle;
  text: string;
  ctaLabel?: string;
  meta?: string;
}

const {
  headingId,
  keyword,
  title,
  text,
  ctaLabel = "Reservar una llamada",
  meta = "30 minutos · Sin compromiso · Directamente conmigo",
} = Astro.props;
const hasVisual = Astro.slots.has("visual");
---

<section
  class:list={["closing", { "closing-solo": !hasVisual }]}
  aria-labelledby={headingId}
>
  <div class="closing-inner">
    <div class="closing-copy">
      <SectionHeading
        id={headingId}
        keyword={keyword}
        title={title}
        class="closing-display"
      />
      <p class="lede">{text}</p>
      <BookingButton label={ctaLabel} />
      <p class="meta">{meta}</p>
    </div>
    {hasVisual && (
      <div class="closing-visual">
        <slot name="visual" />
      </div>
    )}
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    margin-inline: -1rem;
    padding: 4rem 1rem;
    overflow: hidden;
    border-block: 1px solid var(--hairline-quiet);
    background: var(--ink-closing);
  }

  .closing::before {
    content: "";
    position: absolute;
    inset: -30% -10%;
    z-index: -1;
    background: radial-gradient(
      ellipse 50% 55% at 75% 50%,
      rgb(var(--sky-signal-rgb) / 0.16),
      transparent 70%
    );
    pointer-events: none;
  }

  .closing-solo::before {
    content: none;
  }

  .closing-inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    max-width: 56rem;
    margin-inline: auto;
  }

  .closing-copy :global(.closing-display) {
    max-width: 16ch;
    margin: 0 0 1.25rem;
    font-size: clamp(2.1rem, 5.5vw, 3.75rem);
    line-height: 1.04;
  }

  .closing-copy .lede {
    max-width: 48ch;
    margin: 0 0 1.75rem;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .meta {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .closing-inner {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 3rem;
    }

    .closing-solo .closing-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
