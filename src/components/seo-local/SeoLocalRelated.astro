---
import { internalLinksBySource } from "@/data/internal-links"
import { seoLocal } from "@/data/services"

const links = internalLinksBySource[seoLocal.slug] ?? []
---

{
  links.length > 0 && (
    <nav class="related" aria-label="Contenido relacionado">
      <span class="label">Sigue leyendo</span>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.path}>{link.anchor}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(51 65 85);
  }

  .label {
    color: rgb(148 163 184);
    font-size: 0.875rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border: 1px solid rgb(51 65 85);
    border-radius: 9999px;
    color: rgb(226 232 240);
    font-size: 0.9rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  a:hover {
    border-color: rgb(56 189 248);
    color: rgb(125 211 252);
  }

  a:focus-visible {
    outline: 2px solid rgb(56 189 248);
    outline-offset: 3px;
  }
</style>
