---
import "@/styles/template.css";

interface Props {
  links: { path: string; anchor: string }[];
  label?: string;
  ariaLabel?: string;
}

const {
  links,
  label = "Sigue leyendo",
  ariaLabel = "Contenido relacionado",
} = Astro.props;
---

{links.length > 0 && (
  <nav class="related" aria-label={ariaLabel}>
    <span class="label">{label}</span>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.path}>{link.anchor}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .related {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .label {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--hairline);
    border-radius: 9999px;
    color: var(--text-body);
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }

  a:hover {
    border-color: var(--sky-signal);
    color: var(--sky-accent);
  }

  a:focus-visible {
    outline: 2px solid var(--sky-signal);
    outline-offset: 3px;
  }
</style>
