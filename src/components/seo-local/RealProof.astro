---
import "@fontsource/instrument-serif/400-italic.css"
import Projects from "@/components/Projects.astro"
import type { GoogleReviewsData } from "@/lib/google-reviews"

interface Props {
  reviews: GoogleReviewsData | null
}

const { reviews } = Astro.props
const quote = reviews && reviews.reviews.length > 0 ? reviews.reviews[0] : null
const stars = quote ? Math.round(quote.rating) : 0
const starPoints = "12 3 14.6 9 21 9.6 16.2 13.9 17.6 20.2 12 17 6.4 20.2 7.8 13.9 3 9.6 9.4 9"
---

<section class="proof" aria-labelledby="prueba-title">
  <h2 id="prueba-title" class="kw">Webs de negocios locales en Sevilla</h2>
  <p class="display">Trabajo que <em>puedes ver</em></p>

  {
    quote && reviews && (
      <figure class="quote">
        <blockquote>
          <p>{quote.text}</p>
        </blockquote>
        <figcaption>
          <div class="stars" role="img" aria-label={`Valoración: ${quote.rating} de 5 estrellas`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false" class:list={{ on: i < stars }}>
                <polygon points={starPoints} />
              </svg>
            ))}
          </div>
          <span class="author">{quote.author}</span>
          {quote.relativeTime && <span class="when">{quote.relativeTime}</span>}
          {reviews.placeId && (
            <a href={`https://search.google.com/local/reviews?placeid=${reviews.placeId}`} target="_blank" rel="noopener noreferrer">
              Ver todas las reseñas en Google
            </a>
          )}
        </figcaption>
      </figure>
    )
  }

  <div class="sites">
    <p class="sites-note">
      Dos webs reales de negocios de Sevilla, hechas por mí. Puedes visitarlas y juzgar el trabajo por ti.
    </p>
    <Projects only={["arkady", "adfsevilla"]} />
  </div>
</section>

<style>
  .kw {
    margin: 0 0 0.6rem;
    color: rgb(203 213 225);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .proof {
    display: grid;
    gap: 3rem;
    color: rgb(226 232 240);
  }

  .display {
    max-width: 20ch;
    margin: 0;
    color: white;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .display em {
    color: rgb(125 211 252);
    font-family: "Instrument Serif", Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.12em;
    letter-spacing: -0.01em;
  }

  .quote {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid rgb(51 65 85);
    border-radius: 1.25rem;
    background: rgb(8 15 32);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    max-width: 65ch;
    margin: 0;
    color: white;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.5;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    color: rgb(203 213 225);
    font-size: 0.95rem;
  }

  .stars {
    display: flex;
    gap: 0.15rem;
    color: rgb(250 204 21);
  }

  .stars svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
  }

  .stars svg.on {
    fill: currentColor;
  }

  .author {
    color: white;
    font-weight: 600;
  }

  figcaption a {
    margin-left: auto;
    color: rgb(125 211 252);
    text-underline-offset: 0.25em;
  }

  figcaption a:focus-visible {
    outline: 2px solid rgb(56 189 248);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .sites-note {
    max-width: 65ch;
    margin: 0 0 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(51 65 85);
    color: rgb(203 213 225);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .quote {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
      padding: 2rem;
    }

    figcaption {
      flex-direction: column;
      align-items: flex-start;
    }

    figcaption a {
      margin-left: 0;
    }
  }
</style>
