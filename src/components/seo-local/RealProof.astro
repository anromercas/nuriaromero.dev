---
import Projects from "@/components/Projects.astro"
import SectionHeading from "@/components/seo-local/SectionHeading.astro"
import "@/styles/template.css"
import type { GoogleReviewsData } from "@/lib/google-reviews"
import type { AccentTitle } from "./types"

interface Props {
  headingId?: string
  id?: string
  keyword: string
  title: AccentTitle
  reviews: GoogleReviewsData | null
  note: string
  projects: string[]
}

const { headingId = "prueba-title", id, keyword, title, reviews, note, projects } = Astro.props
const quote = reviews && reviews.reviews.length > 0 ? reviews.reviews[0] : null
const stars = quote ? Math.round(quote.rating) : 0
const starPoints = "12 3 14.6 9 21 9.6 16.2 13.9 17.6 20.2 12 17 6.4 20.2 7.8 13.9 3 9.6 9.4 9"
---

<section id={id} class:list={["proof", { "scroll-m-20": id }]} aria-labelledby={headingId}>
  <SectionHeading id={headingId} keyword={keyword} title={title} class="proof-display" />

  {
    quote && reviews && (
      <figure class="quote">
        <blockquote>
          <p>{quote.text}</p>
        </blockquote>
        <figcaption>
          <div class="stars" role="img" aria-label={`Valoración: ${quote.rating} de 5 estrellas`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false" class:list={{ on: i < stars }}>
                <polygon points={starPoints} />
              </svg>
            ))}
          </div>
          <span class="author">{quote.author}</span>
          {quote.relativeTime && <span class="when">{quote.relativeTime}</span>}
          {reviews.placeId && (
            <a href={`https://search.google.com/local/reviews?placeid=${reviews.placeId}`} target="_blank" rel="noopener noreferrer">
              Ver todas las reseñas en Google
            </a>
          )}
        </figcaption>
      </figure>
    )
  }

  <div class="sites">
    <p class="sites-note">{note}</p>
    <Projects only={projects} />
  </div>
</section>

<style>
  .proof {
    display: grid;
    gap: 3rem;
    color: var(--text-body);
  }

  .proof :global(.proof-display) {
    max-width: 20ch;
    margin: 0;
  }

  .quote {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--hairline);
    border-radius: 1.25rem;
    background: var(--card-surface);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    max-width: 65ch;
    margin: 0;
    color: var(--text-strong);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.5;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .stars {
    display: flex;
    gap: 0.15rem;
    color: var(--yellow-recommend);
  }

  .stars svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
  }

  .stars svg.on {
    fill: currentColor;
  }

  .author {
    color: var(--text-strong);
    font-weight: 600;
  }

  figcaption a {
    margin-left: auto;
    color: var(--sky-accent);
    text-underline-offset: 0.25em;
  }

  figcaption a:focus-visible {
    outline: 2px solid var(--sky-signal);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .sites-note {
    max-width: 65ch;
    margin: 0 0 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .quote {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
      padding: 2rem;
    }

    figcaption {
      flex-direction: column;
      align-items: flex-start;
    }

    figcaption a {
      margin-left: 0;
    }
  }
</style>
