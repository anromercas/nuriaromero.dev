---
/* ContactForm.astro – envío con fetch (sin redirección) */

interface Props {
  title?: string;
  description?: string;
}

const {
  // title = 'Contáctame',
  description = '¿Tienes alguna pregunta o quieres trabajar conmigo? Envíame un mensaje y me pondré en contacto contigo lo antes posible.',
} = Astro.props;

// Endpoint de Formspree (sustituye si cambias el formulario)
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mdklbyaz';
---

<div class="w-full max-w-2xl mx-auto space-y-6">
  <div class="text-center">
    <!-- <h2 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">{title}</h2> -->
    {description && (
      <p class="mt-3 text-lg text-gray-500 dark:text-gray-300">
        {description}
      </p>
    )}
  </div>

  <!-- Importante: sin action/method para evitar la navegación -->
  <form id="contact-form" class="space-y-6" novalidate>
    <div class="space-y-4">
      <!-- Honeypot (antispam): esconder via CSS -->
      <div class="hidden">
        <label>
          No rellenar este campo
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
          Nombre <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white"
          placeholder="Tu nombre completo"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Correo electrónico <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white"
            placeholder="tu@email.com"
          />
        </div>

        <div>
          <label for="phone" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Teléfono
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white"
            placeholder="+34 600 000 000"
          />
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
          Mensaje <span class="text-red-500">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows={4}
          required
          class="w-full px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white"
          placeholder="¿En qué puedo ayudarte?"
        ></textarea>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3">
      <p id="form-status"
         class="text-sm text-gray-600 dark:text-gray-300"
         aria-live="polite"
         aria-atomic="true"></p>

      <button
        id="submit-btn"
        type="submit"
        class="px-6 py-2 text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Enviar mensaje
      </button>
    </div>
  </form>
</div>

<style>
  form { scroll-margin-top: 2rem; }
  input:focus, textarea:focus { outline: none; }
</style>

<script>
  const form = document.getElementById('contact-form');
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');
  const ENDPOINT = 'https://formspree.io/f/mdklbyaz';

  function setStatus(msg, type = 'info') {
    statusEl.textContent = msg;
    statusEl.classList.remove('text-red-600','text-green-600','text-gray-600','dark:text-gray-300');
    if (type === 'success') statusEl.classList.add('text-green-600');
    else if (type === 'error') statusEl.classList.add('text-red-600');
    else statusEl.classList.add('text-gray-600','dark:text-gray-300');
  }

  async function postFormData() {
    const data = new FormData(form);
    const res = await fetch(ENDPOINT, {
      method: 'POST',
      body: data,
      headers: { 'Accept': 'application/json' }
    });
    return res;
  }

  async function postJSON() {
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());
    const res = await fetch(ENDPOINT, {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    });
    return res;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (submitBtn.disabled) return;

    if (!form.checkValidity()) {
      setStatus('Por favor, completa los campos requeridos.', 'error');
      form.reportValidity?.();
      return;
    }

    submitBtn.disabled = true;
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Enviando…';
    setStatus('');

    try {
      let res;
      // 1º intento: FormData (evita preflight CORS)
      try {
        res = await postFormData();
      } catch (e) {
        // Si la red bloquea (bloqueador o CORS duro), intentamos JSON
        console.warn('FormData fetch failed, trying JSON', e);
        res = await postJSON();
      }

      if (res.ok) {
        setStatus('✅ ¡Mensaje enviado correctamente! Te responderé en breve.', 'success');
        form.reset();
      } else {
        let msg = `❌ Error ${res.status}`;
        try {
          const json = await res.json();
          if (json?.errors?.length) {
            msg += ' · ' + json.errors.map(e => e.message).join(' ');
          } else if (json?.message) {
            msg += ' · ' + json.message;
          }
        } catch (parseErr) {
          const text = await res.text().catch(() => '');
          if (text) msg += ' · ' + text.slice(0, 200);
        }
        console.error('Formspree error response:', res);
        setStatus(msg, 'error');
      }
    } catch (err) {
      console.error('Network/JS error sending form:', err);
      setStatus('⚠️ Error de conexión (posible CORS o bloqueador).', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>

