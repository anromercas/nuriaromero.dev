---
/* ContactForm.astro – envío con fetch tipado (sin redirección) */
import { localTrust } from "@/data/local-trust";

interface Props {
  title?: string;
  description?: string;
}

const {
  // title = 'Contáctame',
  description = '¿Tienes alguna pregunta o quieres trabajar conmigo? Envíame un mensaje y me pondré en contacto contigo lo antes posible.',
} = Astro.props;

const showReviewInvite =
  localTrust.gbp.status === "verified" && Boolean(localTrust.gbp.writeReviewUrl);
---

<div class="w-full space-y-5 rounded-[1.25rem] border border-slate-700 bg-[var(--card-surface)] p-5 sm:p-6">
  <div class="text-left">
    <!-- <h2 class="text-3xl font-bold text-white sm:text-4xl">{title}</h2> -->
    {description && (
      <p class="m-0 text-base leading-relaxed text-slate-300">
        {description}
      </p>
    )}
  </div>

  <form id="contact-form" class="space-y-5" novalidate>
    <div class="space-y-4">
      <!-- Honeypot (antispam) -->
      <div class="hidden">
        <label>
          No rellenar este campo
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-slate-200">
          Nombre <span class="text-slate-400">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full rounded-lg border border-slate-400/60 bg-[var(--ink-ground)] px-4 py-2.5 text-base text-white placeholder:text-slate-400 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-slate-400 focus:border-sky-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
          placeholder="Tu nombre completo"
        />
      </div>

      <div class="grid grid-cols-1 gap-4">
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium text-slate-200">
            Correo electrónico <span class="text-slate-400">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full rounded-lg border border-slate-400/60 bg-[var(--ink-ground)] px-4 py-2.5 text-base text-white placeholder:text-slate-400 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-slate-400 focus:border-sky-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
            placeholder="tu@email.com"
          />
        </div>

        <div>
          <label for="phone" class="mb-1.5 block text-sm font-medium text-slate-200">
            Teléfono
          </label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="w-full rounded-lg border border-slate-400/60 bg-[var(--ink-ground)] px-4 py-2.5 text-base text-white placeholder:text-slate-400 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-slate-400 focus:border-sky-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
            placeholder="+34 600 000 000"
          />
        </div>
      </div>

      <div>
        <label for="message" class="mb-1.5 block text-sm font-medium text-slate-200">
          Mensaje <span class="text-slate-400">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows={4}
          required
          class="w-full rounded-lg border border-slate-400/60 bg-[var(--ink-ground)] px-4 py-2.5 text-base text-white placeholder:text-slate-400 transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-slate-400 focus:border-sky-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
          placeholder="¿En qué puedo ayudarte?"
        ></textarea>
      </div>

      <div class="flex items-start gap-3">
        <input
          type="checkbox"
          id="privacy"
          name="privacy"
          required
          class="mt-1 size-4 shrink-0 accent-sky-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
        />
        <label for="privacy" class="text-sm leading-relaxed text-slate-300">
          He leído y acepto la
          <a href="/privacidad/" class="rounded-sm text-sky-300 underline decoration-sky-400/70 underline-offset-4 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400">
            política de privacidad
          </a>. <span class="text-slate-400">*</span>
        </label>
      </div>
    </div>

    <div class="space-y-3">
      <div class="flex flex-col-reverse gap-3">
        <p id="form-status"
           class="text-sm text-gray-300 [&.text-red-600]:text-[var(--status-error)] [&.text-green-600]:text-[var(--status-success)]"
           aria-live="polite"
           aria-atomic="true"></p>

        <button
          id="submit-btn"
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-full border border-sky-400 bg-transparent px-5 py-2.5 font-medium text-white transition-colors duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:bg-sky-400/10 hover:text-sky-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Enviar mensaje
        </button>
      </div>

      {showReviewInvite && (
        <p id="form-review-invite" hidden class="text-sm leading-relaxed text-slate-300">
          ¿Ya has trabajado conmigo? Si te apetece, puedes <a
            href={localTrust.gbp.writeReviewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-sm text-sky-300 underline decoration-sky-400/70 underline-offset-4 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-400"
            >dejar una reseña en Google<span class="sr-only"> (se abre en una pestaña nueva)</span></a>.
        </p>
      )}
    </div>
  </form>
</div>

<style>
  form { scroll-margin-top: 2rem; }
  input:focus, textarea:focus { outline: none; }
</style>

<script>
  import "../scripts/contact-form.js"
</script>

