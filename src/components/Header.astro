---
import ThemeToggle from "./ThemeToggle.astro";
import Menu from "./icons/Menu.astro";
import X from "./icons/X.astro";
import { services } from "@/data/services";
import { niches } from "@/data/niches";

const navItems = [
  {
    title: "Inicio",
    label: "inicio",
    url: "/",
  },
  {
    title: "Servicios",
    label: "servicios",
    url: null,
  },
  {
    title: "Portfolio",
    label: "portfolio",
    url: "/portfolio/",
  },
  {
    title: "Blog",
    label: "blog",
    url: "/blog/",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/sobre-mi/",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "/contacto/",
  },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);

const isActive = (url: string | null) => {
  if (!url) return false;
  const target = normalize(url);
  if (target === "/") return currentPath === "/";
  return currentPath === target || currentPath.startsWith(`${target}/`);
};

const dropdownItems = [...services, ...niches].map((page) => ({
  title: page.breadcrumbName,
  url: page.slug,
}));

const isServiciosActive = dropdownItems.some((item) => isActive(item.url));

// Área táctil mínima recomendada (WCAG 2.5.5 / Material): 44x44px.
const navLinkClass =
  "relative flex min-h-11 items-center whitespace-nowrap px-3 transition hover:text-blue-500 dark:hover:text-blue-500";
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2 px-3"
>
  <nav
    class="relative flex px-2 text-sm font-medium rounded-full text-gray-600 dark:text-gray-200 justify-center items-center"
  >
    <ul class="hidden md:flex items-center">
      {
        navItems.map((link) =>
          link.label === "servicios" ? (
            <li class="relative group">
              <button
                type="button"
                class:list={[navLinkClass, { "text-blue-500": isServiciosActive }]}
                aria-label={link.label}
                aria-haspopup="true"
                aria-current={isServiciosActive ? "page" : undefined}
              >
                {link.title}
              </button>
              <div class="absolute left-1/2 hidden -translate-x-1/2 pt-2 group-hover:block group-focus-within:block">
                <ul class="min-w-56 rounded-xl border border-gray-300 bg-white/95 py-2 shadow-lg backdrop-blur dark:border-gray-700 dark:bg-gray-800/95">
                  {dropdownItems.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        class="block px-4 py-2.5 hover:text-blue-500"
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                class:list={[navLinkClass, { "text-blue-500": isActive(link.url) }]}
                aria-label={link.label}
                aria-current={isActive(link.url) ? "page" : undefined}
                href={link.url ?? undefined}
              >
                {link.title}
              </a>
            </li>
          )
        )
      }
    </ul>

    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden relative flex min-h-11 min-w-11 items-center justify-center"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <Menu class="icon-menu size-5" />
      <X class="icon-close size-5" />
    </button>

    <ThemeToggle />
  </nav>
</header>

<div
  id="mobile-menu-overlay"
  class="fixed inset-0 z-40 bg-black/50 md:hidden"
  aria-hidden="true"
>
</div>

<div
  id="mobile-menu"
  class="fixed top-0 right-0 z-50 flex w-[min(320px,80vw)] flex-col overflow-y-auto overscroll-contain border-l border-gray-300 bg-white/95 py-3 shadow-lg backdrop-blur dark:border-gray-700 dark:bg-gray-800/95 md:hidden"
>
  <ul class="flex flex-1 flex-col gap-0.5 px-3">
    {
      navItems.map((link) =>
        link.label === "servicios" ? (
          <li>
            <div class="flex items-stretch">
              <span
                class:list={[
                  "flex min-h-11 flex-1 items-center px-4 py-2.5 leading-[1.375rem]",
                  { "text-blue-500": isServiciosActive },
                ]}
                aria-current={isServiciosActive ? "page" : undefined}
              >
                {link.title}
              </span>
              <button
                type="button"
                class="mobile-accordion-btn flex min-h-11 min-w-11 items-center justify-center text-gray-500 transition hover:text-blue-500 dark:text-gray-400 dark:hover:text-blue-500"
                aria-expanded="false"
                aria-controls="mobile-submenu-servicios"
                aria-label="Mostrar submenú de Servicios"
              >
                <svg
                  class="mobile-accordion-chevron size-4 transition-transform duration-200"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
            <ul
              id="mobile-submenu-servicios"
              class="mobile-accordion-panel ml-3 border-l border-gray-200 dark:border-gray-700"
            >
              {dropdownItems.map((item) => (
                <li>
                  <a
                    href={item.url}
                    class="flex min-h-11 items-center px-4 py-2 text-[0.8125rem] text-gray-500 hover:text-blue-500 dark:text-gray-400 dark:hover:text-blue-500"
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a
              class:list={[
                "block min-h-11 px-4 py-2.5 leading-[1.375rem] flex items-center",
                "hover:text-blue-500 dark:hover:text-blue-500",
                { "text-blue-500": isActive(link.url) },
              ]}
              aria-current={isActive(link.url) ? "page" : undefined}
              href={link.url ?? undefined}
            >
              {link.title}
            </a>
          </li>
        )
      )
    }
  </ul>
</div>

<script>
  import "../scripts/header-mobile-menu.js"
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply dark:bg-gray-800/90 bg-white/50;
  }

  @keyframes nav-shadown {
    0% {
      background-color: transparent;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }

  #mobile-menu {
    /* Fallback para navegadores sin soporte de unidades dinámicas; 100dvh
       evita que la barra de direcciones móvil recorte o desplace el drawer. */
    height: 100vh;
    height: 100dvh;
    visibility: hidden;
    transform: translateX(100%);
    transition:
      transform 0.3s ease,
      visibility 0s linear 0.3s;
  }

  #mobile-menu.open {
    visibility: visible;
    transform: translateX(0);
    transition: transform 0.3s ease;
  }

  #mobile-menu-overlay {
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      visibility 0s linear 0.3s;
    visibility: hidden;
  }

  #mobile-menu-overlay.open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition: opacity 0.3s ease;
  }

  .mobile-accordion-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
  }

  .mobile-accordion-btn[aria-expanded="true"] .mobile-accordion-chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #mobile-menu-overlay,
    .mobile-accordion-panel,
    .mobile-accordion-chevron {
      transition: none !important;
    }
  }

  #mobile-menu-btn .icon-close {
    display: none;
  }

  #mobile-menu-btn[aria-expanded="true"] .icon-menu {
    display: none;
  }

  #mobile-menu-btn[aria-expanded="true"] .icon-close {
    display: block;
  }

  @media (max-width: 640px) {
    nav {
      @apply text-xs;
    }
  }
</style>
