---
import "@/styles/template.css";

interface Props {
  animate?: boolean;
}

const { animate = true } = Astro.props;
const rows = [
  { label: "En el buscador", kind: "search" },
  { label: "En el mapa", kind: "map" },
  { label: "En un asistente de IA", kind: "chat" },
];
---

<figure
  class:list={["mock", { animate }]}
  aria-label="Ejemplo: tu negocio en el buscador, en el mapa y en un asistente de IA"
>
  <div class="strip">
    <svg
      class="pill"
      viewBox="0 0 40 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle cx="16" cy="11" r="6.5" class="signal"></circle>
      <path d="M21 16l5 5" class="signal"></path>
    </svg>
    <span class="query">peluquería en Triana</span>
  </div>

  <ul class="rows">
    {rows.map((row, i) => (
      <li style={`--i:${i}`}>
        <svg
          class="art"
          viewBox="0 0 40 40"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          {row.kind === "search" && (
            <>
              <rect
                x="4"
                y="6"
                width="32"
                height="7"
                rx="3.5"
                class="signal"
              ></rect>
              <rect
                x="4"
                y="17"
                width="32"
                height="7"
                rx="3.5"
                class="soft"
              ></rect>
              <rect
                x="4"
                y="28"
                width="32"
                height="7"
                rx="3.5"
                class="soft"
              ></rect>
            </>
          )}
          {row.kind === "map" && (
            <>
              <path d="M3 30c8-6 14 4 22-2s8-4 12-4" class="soft"></path>
              <path d="M14 36c2-8-2-12 4-18" class="soft"></path>
              <path
                d="M20 22c-4-5-7-8-7-12a7 7 0 0 1 14 0c0 4-3 7-7 12z"
                class="signal"
                transform="translate(0 2)"
              ></path>
              <circle cx="20" cy="12" r="2.5" class="signal"></circle>
            </>
          )}
          {row.kind === "chat" && (
            <>
              <path
                d="M5 6h30a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H18l-7 7v-7H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"
                class="soft"
              ></path>
              <path d="M9 13h16" class="soft"></path>
              <path d="M9 21h22" class="signal"></path>
            </>
          )}
        </svg>
        <div class="text">
          <p class="label">{row.label}</p>
          <p class="name">Tu negocio</p>
        </div>
        <svg
          class="check"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M8 12.5l2.7 2.7L16 9.8"></path>
        </svg>
      </li>
    ))}
  </ul>
  <figcaption>Ejemplo ilustrativo</figcaption>
</figure>

<style>
  .mock {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 1.25rem;
    color: var(--text-body);
    background: var(--card-surface);
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--hairline-quiet);
    background: var(--drawing-surface);
  }

  .pill {
    flex: none;
    width: 2.25rem;
    height: auto;
    color: var(--sky-accent);
  }

  .query {
    min-width: 0;
    color: var(--text-strong);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .rows {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 1.1rem 1.25rem 1.25rem;
    list-style: none;
  }

  .rows li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 1.25rem;
    align-items: center;
    gap: 0.9rem;
  }

  .rows li + li {
    padding-top: 0.9rem;
    border-top: 1px solid var(--hairline-quiet);
  }

  .art {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text-muted);
  }

  .signal {
    stroke: var(--sky-signal);
  }

  .soft {
    stroke: var(--drawing-soft);
  }

  .text p {
    margin: 0;
  }

  .label {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .name {
    color: var(--text-strong);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .check {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--sky-signal);
  }

  figcaption {
    padding: 0.55rem 1.25rem 1rem;
    border-top: 1px solid var(--hairline-quiet);
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* Completed state is the default. Rows only build up where a scroll
     timeline exists and motion is welcome; elsewhere the mock stays complete. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .animate .rows li {
        animation: row-in linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(var(--i) * 40px) calc(var(--i) * 40px + 120px);
      }

      .animate .check path {
        stroke-dasharray: 14;
        animation: check-draw linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(var(--i, 0) * 40px + 60px)
          calc(var(--i, 0) * 40px + 180px);
      }
    }

    @supports not (animation-timeline: scroll()) {
      .animate .rows li {
        animation: row-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: calc(0.3s + var(--i) * 0.25s);
      }
    }
  }

  @keyframes row-in {
    from {
      opacity: 0.6;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes check-draw {
    from {
      stroke-dashoffset: 14;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
