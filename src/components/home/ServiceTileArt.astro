---
// Single-stroke drawings for the home bento tiles. Colours come from
// BentoTile (.signal, .soft, .label), so the drawings carry no style of their own.
interface Props {
  kind:
    | "seo-local"
    | "diseno-web"
    | "tienda-online"
    | "software"
    | "automatizaciones"
    | "ia";
}

const { kind } = Astro.props;
const stars = [0, 1, 2, 3, 4];
---

{kind === "seo-local" && (
  <svg
    viewBox="0 40 360 150"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M44 120c-12-12-24-22-24-36a24 24 0 0 1 48 0c0 14-12 24-24 36z"
      class="signal"
    ></path>
    <circle cx="44" cy="84" r="8" class="signal"></circle>
    <rect x="92" y="52" width="150" height="14" rx="7"></rect>
    <rect x="92" y="76" width="110" height="10" rx="5" class="soft"></rect>
    <rect x="92" y="96" width="130" height="10" rx="5" class="soft"></rect>
    {stars.map((i) => (
      <polygon
        points={`${112 + i * 30} 134 ${115 + i * 30} 142 ${123 + i * 30} 143 ${117 + i * 30} 148 ${119 + i * 30} 156 ${112 + i * 30} 152 ${105 + i * 30} 156 ${107 + i * 30} 148 ${101 + i * 30} 143 ${109 + i * 30} 142`}
        class="signal"
      ></polygon>
    ))}
    <rect x="266" y="52" width="80" height="104" rx="10" class="soft"></rect>
    <rect x="278" y="66" width="56" height="30" rx="5" class="soft"></rect>
    <rect x="278" y="106" width="40" height="8" rx="4" class="soft"></rect>
    <rect x="278" y="124" width="56" height="18" rx="9" class="signal"></rect>
  </svg>
)}

{kind === "diseno-web" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="8" y="8" width="212" height="114" rx="10"></rect>
    <path d="M8 30h212"></path>
    <circle cx="22" cy="19" r="2.5"></circle>
    <circle cx="34" cy="19" r="2.5"></circle>
    <circle cx="46" cy="19" r="2.5"></circle>
    <rect x="22" y="42" width="120" height="12" rx="6" class="signal"></rect>
    <rect x="22" y="64" width="150" height="8" rx="4" class="soft"></rect>
    <rect x="22" y="80" width="126" height="8" rx="4" class="soft"></rect>
    <rect x="22" y="98" width="84" height="14" rx="7"></rect>
    <rect x="236" y="30" width="72" height="92" rx="12" class="signal"></rect>
    <path d="M262 38h20" class="signal"></path>
    <rect x="248" y="54" width="48" height="8" rx="4" class="soft"></rect>
    <rect x="248" y="70" width="36" height="8" rx="4" class="soft"></rect>
  </svg>
)}

{kind === "tienda-online" && (
  <svg
    viewBox="0 0 320 300"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="60" y="8" width="200" height="284" rx="22"></rect>
    <path d="M140 22h40"></path>
    <rect x="80" y="48" width="160" height="52" rx="8"></rect>
    <rect x="92" y="60" width="28" height="28" rx="5" class="soft"></rect>
    <rect x="132" y="62" width="88" height="8" rx="4"></rect>
    <rect x="132" y="78" width="56" height="8" rx="4" class="soft"></rect>
    <rect x="80" y="112" width="160" height="52" rx="8"></rect>
    <rect x="92" y="124" width="28" height="28" rx="5" class="soft"></rect>
    <rect x="132" y="126" width="88" height="8" rx="4"></rect>
    <rect x="132" y="142" width="56" height="8" rx="4" class="soft"></rect>
    <rect x="80" y="176" width="160" height="52" rx="8"></rect>
    <rect x="92" y="188" width="28" height="28" rx="5" class="soft"></rect>
    <rect x="132" y="190" width="88" height="8" rx="4"></rect>
    <rect x="132" y="206" width="56" height="8" rx="4" class="soft"></rect>
    <rect x="80" y="244" width="160" height="30" rx="15" class="signal"></rect>
  </svg>
)}

{kind === "software" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="8" y="8" width="304" height="114" rx="10"></rect>
    <path d="M8 36h304"></path>
    <path d="M8 64h304" class="soft"></path>
    <path d="M8 92h304" class="soft"></path>
    <path d="M250 8v114" class="soft"></path>
    <rect x="22" y="18" width="90" height="8" rx="4" class="signal"></rect>
    <rect x="22" y="46" width="130" height="8" rx="4" class="soft"></rect>
    <rect x="22" y="74" width="106" height="8" rx="4" class="soft"></rect>
    <rect x="22" y="102" width="120" height="8" rx="4" class="soft"></rect>
    <path d="M272 44l5 5 10-10" class="signal"></path>
    <path d="M272 72l5 5 10-10" class="signal"></path>
    <path d="M272 100l5 5 10-10" class="signal"></path>
  </svg>
)}

{kind === "automatizaciones" && (
  <svg
    viewBox="0 0 320 130"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="8" y="34" width="84" height="44" rx="12"></rect>
    <text x="50" y="62" text-anchor="middle" class="label">
      correo
    </text>
    <rect x="118" y="34" width="84" height="44" rx="12" class="signal"></rect>
    <text x="160" y="62" text-anchor="middle" class="label">
      hoja
    </text>
    <rect x="228" y="34" width="84" height="44" rx="12"></rect>
    <text x="270" y="62" text-anchor="middle" class="label">
      factura
    </text>
    <path d="M94 56h22m-6-5 6 5-6 5" class="signal"></path>
    <path d="M204 56h22m-6-5 6 5-6 5" class="signal"></path>
    <path d="M50 78v22h220V78" class="soft"></path>
  </svg>
)}

{kind === "ia" && (
  <svg
    viewBox="0 0 320 150"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M12 8h176a10 10 0 0 1 10 10v34a10 10 0 0 1-10 10H40l-16 14V62h-12a10 10 0 0 1-10-10V18A10 10 0 0 1 12 8z"
      class="soft"
    ></path>
    <text x="104" y="40" text-anchor="middle" class="label">
      ¿Abrís el sábado?
    </text>
    <path
      d="M308 78H132a10 10 0 0 0-10 10v34a10 10 0 0 0 10 10h148l16 14v-14h12a10 10 0 0 0 10-10V88a10 10 0 0 0-10-10z"
      class="signal"
      transform="translate(0 -6)"
    ></path>
    <text x="212" y="112" text-anchor="middle" class="label">
      Sí, de 10 a 14 h
    </text>
  </svg>
)}
