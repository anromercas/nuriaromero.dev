---
import "@/styles/template.css";

interface Props {
  items: { name: string; url: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Miga de pan" class="crumbs">
  <ol>
    {items.map((item, i) => (
      <li>
        {i > 0 && (
          <span class="crumbs-sep" aria-hidden="true">
            /
          </span>
        )}
        {i === items.length - 1 ? (
          <span aria-current="page" class="crumbs-current">
            {item.name}
          </span>
        ) : (
          <a href={item.url} class="tpl-link">
            {item.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs {
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .crumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .crumbs a {
    display: inline-block;
    padding-block: 0.1875rem;
  }
  .crumbs-sep {
    color: var(--text-muted);
    user-select: none;
  }
  .crumbs-current {
    color: var(--text-secondary);
    cursor: default;
  }
</style>
