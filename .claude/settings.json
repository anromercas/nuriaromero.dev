{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.astro|*.ts|*.js|*.mjs|*.css|*.json|*.md) pnpm exec prettier --write \"$f\" >/dev/null 2>&1 || true;; esac"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "team-harness@nuriaromerodev-harness": true
  },
  "permissions": {
