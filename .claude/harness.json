{
  "$schema": "/Users/nuria/Desktop/code/nuriaromerodev/proyectos internos nuriaromero.dev/team-harness/templates/harness.schema.json",
  "version": 1,
  "project": {
    "name": "nuriaromero.dev",
    "slug": "nuriaromero",
    "reportLanguage": "es",
    "artifactLanguage": "en",
    "summary": "Portfolio and local services site of Nuria Romero, a freelance web developer and local SEO/GEO consultant in Seville (web design, online stores, local SEO, custom software, automations, AI). Static Astro 4 + Tailwind + TypeScript site deployed on Netlify; all site copy is in Spanish."
  },
  "repo": {
    "github": "anromercas/nuriaromero.dev",
    "baseBranch": "develop",
    "branchPattern": "{type}/{KEY}-{slug}",
    "mergeMethod": "merge",
    "untrackedPaths": [
      ".claude/state/",
      ".env",
      ".playwright-mcp/",
      ".netlify/"
    ],
    "qaExemptPaths": [
      "docs/",
      "odd/",
      "seo/ranks/",
      ".github/workflows/",
      ".gitignore",
      "README.md",
      "PRODUCT.md",
      "DESIGN.md"
    ]
  },
  "tracker": {
    "type": "jira",
    "site": "nuriaromerodev.atlassian.net",
    "cloudId": "1a60def7-1fc1-499d-990b-dd942c4c8456",
    "projectKey": "NRD",
    "boardId": 37,
    "issueTypeIds": {
      "story": "10052",
      "epic": "10049",
      "subtask": "10050",
      "bug": "10054"
    },
    "issueTypeNames": {
      "story": "Historia",
      "epic": "Epic",
      "subtask": "Subtask",
      "bug": "Error"
    },
    "fields": {
      "storyPoints": "customfield_10016",
      "sprint": "customfield_10020"
    },
    "statuses": {
      "todo": "Tareas por hacer",
      "inProgress": "En curso",
      "done": "Finalizada"
    },
    "transitionIds": {
      "inProgress": null,
      "done": null
    },
    "sprintNaming": "{KEY} Sprint {n}",
    "sprintLengthDays": 14,
    "initialCapacityPoints": 20,
    "labels": {
      "tech-ready": "tech-ready",
      "tech-blocked": "tech-blocked",
      "needs-tech-answer": "needs-tech-answer",
      "dev-done": "dev-done",
      "qa-failed": "qa-failed",
      "qa-bug": "qa-bug",
      "pr-changes": "pr-changes",
      "pr-approved": "pr-approved",
      "needs-human": "needs-human",
      "infra": "infra",
