    },
    "blockingLabels": [
      "needs-human",
      "qa-failed",
      "pr-changes"
    ]
  },
  "process": {
    "tdd": true,
    "conventionalCommits": true,
    "wipLimit": 1
  },
  "commands": {
    "install": "pnpm install",
    "dev": "pnpm dev --port {port} --strictPort",
    "unitTest": "node --test tests/*.test.js",
    "singleTest": "node --test {file}",
    "e2e": null,
    "typecheck": "pnpm astro check",
    "lint": null,
    "formatCheck": null,
    "format": "pnpm format {file}",
    "build": "pnpm build",
    "preShip": [
      "node --test tests/*.test.js",
      "pnpm build"
    ],
    "preCommit": [
      "node --test tests/*.test.js"
    ]
  },
  "ci": {
    "workflowFile": "ci.yml",
    "requiredChecks": [
      "verify"
    ],
    "checkApp": "github-actions",
    "mainHealthWorkflow": "ci.yml"
  },
  "layers": {
    "app": {
      "description": "The whole static site: pages, layouts, components, content collections, data, client scripts, styles, public assets, build-time SEO checks and their tests.",
      "paths": [
        "src/**",
        "public/**",
        "tests/**",
        "scripts/**",
        "astro.config.mjs",
        "tailwind.config.mjs",
        "tsconfig.json",
        "package.json"
      ],
      "owner": "team-harness:developer",
      "testing": "node:test files in tests/*.test.js (run with node --test). Build-time SEO checks in scripts/check-seo-*.mjs run against dist/ after pnpm build. Site copy stays in Spanish."
    }
  },
  "design": {
    "mode": "markdown",
    "markdown": {
      "changesDir": "docs/designs",
      "template": null,
      "naming": "{KEY}-{storySlug}.md"
    },
    "adrDir": "docs/adr",
    "prdPath": "docs/PRD.md",
    "ux": {
      "enabled": true,
      "skill": "impeccable:impeccable",
      "uiLayers": [
        "app"
      ]
    }
  },
  "review": {
    "adversarial": {
      "codex": false,
      "codexModel": null,
      "codexEffort": "high"
    },
    "specialists": [
      {
        "agent": "seo-review",
        "paths": [
          "src/pages/**",
          "src/layouts/**",
          "src/content/**",
          "src/components/seo/**",
          "src/lib/schema.ts",
          "src/data/**",
          "public/llms.txt",
          "public/_redirects",
          "public/_headers",
          "astro.config.mjs"
        ],
        "when": "Any change to public pages, layouts, blog content, head/meta, structured data, site data, robots/sitemap config, llms.txt or redirects; checks indexability, structured data and the SEO candidate the story implements."
      },
      {
        "agent": "ux-review",
        "paths": [
          "src/pages/**",
          "src/layouts/**",
          "src/components/**",
          "src/styles/**",
          "tailwind.config.mjs"
        ],
        "when": "Any change to pages, layouts, components or styles; checks the built UI against the story UI spec and DESIGN.md."
      },
      {
        "agent": "a11y-responsive",
        "paths": [
          "src/pages/**",
          "src/layouts/**",
          "src/components/**",
          "src/scripts/**",
          "src/styles/**",
          "tailwind.config.mjs"
        ],
        "when": "Any change to markup, client scripts or styles; checks WCAG semantics, keyboard, focus, contrast and mobile reflow at 375 px."
      },
      {
        "agent": "compliance-privacy",
        "paths": [
          "src/components/ContactForm.astro",
          "src/scripts/contact-form.js",
          "src/components/AnalyticsConsent.astro",
          "src/scripts/analytics-consent.js",
          "src/pages/privacidad.astro",
          "src/pages/cookies.astro",
          "src/pages/aviso-legal.astro",
          "public/_headers"
        ],
        "when": "Any change to the contact form, analytics consent, legal pages or CSP; checks RGPD/LOPDGDD and LSSI-CE compliance."
      }
    ]
  },
  "qa": {
    "devUrl": "http://localhost:4399",
    "devPort": 4399,
    "cdpPort": 9333,
    "browser": "devtools-mcp",
    "e2eCommand": null,
    "evidenceDir": "$TMPDIR/{slug}-qa/{KEY}",
